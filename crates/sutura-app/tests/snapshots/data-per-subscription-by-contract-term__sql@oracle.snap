---
source: crates/sutura-app/tests/golden/dialects.rs
assertion_line: 39
expression: query.sql()
---
SELECT "fct_subscription_monthly"."contract_term" AS "contract_term", CAST(TRUNC("fct_usage_daily"."usage_date", 'MM') AS DATE) AS "period", CAST(SUM("fct_usage_daily"."data_gb") AS DOUBLE PRECISION) / NULLIF(COUNT(DISTINCT "fct_usage_daily"."subscription_key"), 0) AS "data_per_subscription" FROM "fct_usage_daily" LEFT JOIN "fct_subscription_monthly" ON "fct_usage_daily"."subscription_key" = "fct_subscription_monthly"."subscription_key" AND CAST(TRUNC("fct_usage_daily"."usage_date", 'MM') AS DATE) = "fct_subscription_monthly"."month" WHERE "fct_usage_daily"."usage_date" >= :1 AND "fct_usage_daily"."usage_date" < :2 GROUP BY "fct_subscription_monthly"."contract_term", CAST(TRUNC("fct_usage_daily"."usage_date", 'MM') AS DATE) ORDER BY "fct_subscription_monthly"."contract_term", CAST(TRUNC("fct_usage_daily"."usage_date", 'MM') AS DATE) LIMIT 10001
