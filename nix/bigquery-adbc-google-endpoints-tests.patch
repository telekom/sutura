+			if mode == "domain_delegation" {
+				delete(opts, "bigquery.auth.access_token")
+				opts["bigquery.auth_type"] = "app_default_credentials"
+				opts["bigquery.impersonate.target_principal"] = "delegating@test-project.iam.gserviceaccount.com"
+				opts["bigquery.impersonate.subject"] = "user@example.com"
+				opts["bigquery.impersonate.scopes"] = "https://www.googleapis.com/auth/bigquery.readonly"
+			}
+			ctx := context.Background()
+			db, err := NewDriver(memory.DefaultAllocator).NewDatabaseWithContext(ctx, opts)
+			if err != nil {
+				t.Fatal(err)
