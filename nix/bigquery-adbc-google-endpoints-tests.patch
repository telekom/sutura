+func TestGooglePrivateEndpointOptionsRoundTrip(t *testing.T) {
+	// Option spelling and values survive the database setter/getter boundary.
+	opts := map[string]string{"bigquery.iam_credentials_endpoint": "https://iamcredentials-example.p.googleapis.com/", "bigquery.oauth_token_endpoint": "https://oauth2-example.p.googleapis.com/token", "bigquery.sts_endpoint": "https://sts-example.p.googleapis.com/v1/token"}
+	db, err := NewDriver(memory.DefaultAllocator).NewDatabaseWithContext(context.Background(), opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for key, want := range opts {
+		got, err := db.(adbc.GetSetOptionsWithContext).GetOption(context.Background(), key)
+		if err != nil || got != want {
+			t.Fatal(fmt.Sprintf("%s: %q %v", key, got, err))
+		}
+	}
+	t.Run("invalid_destinations", func(t *testing.T) {
+		for index, endpoint := range []string{
+			"http://sts-example.p.googleapis.com/v1/token",
+			"https://sts.googleapis.com.example.com/v1/token",
+			"https://example.com/v1/token",
+			"https://user:private-token@sts.googleapis.com/v1/token",
+			"https://sts.googleapis.com/v1/token?private-token=secret",
+			"https://sts.googleapis.com/v1/token#private-token",
+		} {
+			for _, service := range []string{"sts", "oauth", "iam"} {
+				t.Run(fmt.Sprintf("%s/%d", service, index), func(t *testing.T) {
+					recorder := &googleEndpointRecorder{}
+					destinations := googleDestinations{}
+					origin := "https://sts.googleapis.com/v1/token"
+					switch service {
+					case "sts":
+						destinations.sts = endpoint
+					case "oauth":
+						destinations.oauth = endpoint
+						origin = "https://oauth2.googleapis.com/token"
+					case "iam":
+						destinations.iam = endpoint
+						origin = "https://iamcredentials.googleapis.com/v1/serviceAccounts/fixture:signJwt"
+					}
+					request, err := http.NewRequest("POST", origin, strings.NewReader("fixture-assertion"))
+					if err != nil {
+						t.Fatal(err)
+					}
+					response, err := (googleRoutingTransport{base: recorder, destinations: destinations}).RoundTrip(request)
+					if response != nil {
+						response.Body.Close()
+					}
+					if err == nil || !strings.Contains(err.Error(), "invalid Google API destination") || len(recorder.requests) != 0 {
+						t.Fatalf("invalid %s destination reached transport: requests=%d err=%v", service, len(recorder.requests), err)
+					}
+				})
+			}
+		}
+
+	})
+
+}
