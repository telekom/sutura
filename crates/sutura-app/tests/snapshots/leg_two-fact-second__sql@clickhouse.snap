source: crates/sutura-app/tests/golden/legs.rs
expression: query.sql()
---
SELECT "fct_ticket_monthly"."customer_key" AS "0_link", CAST(dateTrunc('month', "dim_calendar"."month") AS DATE) AS "period", if(toTypeName(sum("fct_ticket_monthly"."tickets")) IN ('Int64', 'UInt64', 'Nullable(Int64)', 'Nullable(UInt64)'), tuple('Int128', CAST(sum(accurateCastOrNull("fct_ticket_monthly"."tickets", 'Int128')) AS Dynamic)), tuple(toTypeName(sum("fct_ticket_monthly"."tickets")), CAST(sum("fct_ticket_monthly"."tickets") AS Dynamic))) AS "0_leaf_0" FROM "fct_ticket_monthly" LEFT JOIN "dim_calendar" ON "fct_ticket_monthly"."month" = "dim_calendar"."month" WHERE "dim_calendar"."month" >= ? AND "dim_calendar"."month" < ? GROUP BY "fct_ticket_monthly"."customer_key", CAST(dateTrunc('month', "dim_calendar"."month") AS DATE) ORDER BY "fct_ticket_monthly"."customer_key", CAST(dateTrunc('month', "dim_calendar"."month") AS DATE)
