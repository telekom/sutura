+func TestGoogleStorageEndpointKeepsTLS(t *testing.T) {
+	config := &tls.Config{MinVersion: tls.VersionTLS12}
+	for _, endpoint := range []string{"", "bigquerystorage.googleapis.com:443", "bigquerystorage-example.p.googleapis.com:443"} {
+		creds := googleStorageCredentials(endpoint, config)
+		if got := creds.Info().SecurityProtocol; got != "tls" {
+			t.Fatalf("%s: got %s instead of verified TLS", endpoint, got)
+		}
+	}
+	if got := googleStorageCredentials("127.0.0.1:12345", config).Info().SecurityProtocol; got != "insecure" {
+		t.Fatalf("loopback emulator protocol: %s", got)
+	}
+}
