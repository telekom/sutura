---
source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT "dim_product"."product_family" AS "product_family", CAST(dateTrunc('month', "fct_usage_daily"."usage_date") AS DATE) AS "period", if(toTypeName(sum("fct_usage_daily"."voice_min")) IN ('Int64', 'Nullable(Int64)', 'UInt64', 'Nullable(UInt64)', 'Int128', 'Nullable(Int128)'), tuple('Int128', toDecimal256(sum(accurateCastOrNull("fct_usage_daily"."voice_min", 'Int128')), 0), CAST(NULL AS Nullable(Decimal(76, 38))), CAST(NULL AS Nullable(Float64))), tuple(toTypeName(sum("fct_usage_daily"."voice_min")), CAST(NULL AS Nullable(Decimal(76, 0))), if(toTypeName(sum("fct_usage_daily"."voice_min")) LIKE '%Decimal(%', toDecimal256(sum("fct_usage_daily"."voice_min"), 38), NULL), if(toTypeName(sum("fct_usage_daily"."voice_min")) LIKE '%Float%', toFloat64(sum("fct_usage_daily"."voice_min")), NULL))) AS "voice_minutes" FROM "fct_usage_daily" LEFT JOIN "fct_subscription_monthly" ON "fct_usage_daily"."subscription_key" = "fct_subscription_monthly"."subscription_key" AND CAST(dateTrunc('month', "fct_usage_daily"."usage_date") AS DATE) = "fct_subscription_monthly"."month" LEFT JOIN "dim_product" ON "fct_subscription_monthly"."product_key" = "dim_product"."product_key" WHERE "fct_usage_daily"."usage_date" >= ? AND "fct_usage_daily"."usage_date" < ? GROUP BY "dim_product"."product_family", CAST(dateTrunc('month', "fct_usage_daily"."usage_date") AS DATE) ORDER BY "dim_product"."product_family", CAST(dateTrunc('month', "fct_usage_daily"."usage_date") AS DATE) LIMIT 10001
