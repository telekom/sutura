+func TestExecutePartitionsRefusesDryRun(t *testing.T) {
+	st := &statement{
+		queryConfig: bigquery.QueryConfig{
+			Q:      "SELECT 1",
+			DryRun: true,
+		},
+	}
+
+	_, partitions, rows, err := st.ExecutePartitions(context.Background())
+	if err == nil {
+		t.Fatal("ExecutePartitions: expected an error for a dry run, got nil")
+	}
+	adbcErr, ok := err.(adbc.Error)
+	if !ok {
+		t.Fatalf("ExecutePartitions: error %v is not an adbc.Error", err)
+	}
+	if adbcErr.Code != adbc.StatusInvalidState {
+		t.Fatalf("ExecutePartitions: code = %v, want StatusInvalidState", adbcErr.Code)
+	}
+	if partitions.NumPartitions != 0 || len(partitions.PartitionIDs) != 0 {
+		t.Fatalf("ExecutePartitions: expected no partitions on refusal, got %+v", partitions)
+	}
+	if rows != -1 {
+		t.Fatalf("ExecutePartitions: rows = %d, want -1", rows)
+	}
+}
