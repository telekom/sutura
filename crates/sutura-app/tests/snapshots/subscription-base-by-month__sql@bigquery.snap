source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT CAST(DATE_TRUNC(`fct_subscription_monthly`.`month`, MONTH) AS DATE) AS `period`, COUNT(DISTINCT `fct_subscription_monthly`.`subscription_key`) AS `subscription_base` FROM `fct_subscription_monthly` WHERE `fct_subscription_monthly`.`month` >= ? AND `fct_subscription_monthly`.`month` < ? GROUP BY CAST(DATE_TRUNC(`fct_subscription_monthly`.`month`, MONTH) AS DATE) ORDER BY CAST(DATE_TRUNC(`fct_subscription_monthly`.`month`, MONTH) AS DATE) LIMIT 10001
