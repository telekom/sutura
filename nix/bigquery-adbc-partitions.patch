+func TestPartitionDescriptorRoundTrip(t *testing.T) {
+	streamName := "projects/p/locations/us/sessions/s1/streams/stream-0"
+	descriptor := encodePartitionDescriptor(streamName)
+
+	got, err := decodePartitionDescriptor(descriptor)
+	if err != nil {
+		t.Fatalf("decodePartitionDescriptor: unexpected error: %v", err)
+	}
+	if got != streamName {
+		t.Fatalf("decodePartitionDescriptor: got %q, want %q", got, streamName)
+	}
+
+	// The descriptor carries only the stream name: nothing else should have
+	// been smuggled in alongside it.
+	if len(descriptor) != 1+len(streamName) {
+		t.Fatalf("descriptor length = %d, want %d", len(descriptor), 1+len(streamName))
+	}
+}
+
+func TestPartitionDescriptorMalformedRefused(t *testing.T) {
+	cases := map[string][]byte{
+		"empty":           {},
+		"version only":    {partitionDescriptorV1},
+		"unknown version": append([]byte{partitionDescriptorV1 + 1}, "stream"...),
+		"nil":             nil,
+	}
+
+	for name, descriptor := range cases {
+		t.Run(name, func(t *testing.T) {
+			_, err := decodePartitionDescriptor(descriptor)
+			if err == nil {
+				t.Fatalf("decodePartitionDescriptor(%q): expected an error, got nil", descriptor)
+			}
+			adbcErr, ok := err.(adbc.Error)
+			if !ok {
+				t.Fatalf("decodePartitionDescriptor(%q): error %v is not an adbc.Error (would otherwise risk a panic further up the call stack)", descriptor, err)
+			}
+			if adbcErr.Code != adbc.StatusInvalidArgument {
+				t.Fatalf("decodePartitionDescriptor(%q): code = %v, want StatusInvalidArgument", descriptor, adbcErr.Code)
+			}
+		})
+	}
+}
+
+func TestExecutePartitionsRefusesDryRun(t *testing.T) {
+	st := &statement{
+		queryConfig: bigquery.QueryConfig{
+			Q:      "SELECT 1",
+			DryRun: true,
+		},
+	}
+
+	_, partitions, rows, err := st.ExecutePartitions(context.Background())
+	if err == nil {
+		t.Fatal("ExecutePartitions: expected an error for a dry run, got nil")
+	}
+	adbcErr, ok := err.(adbc.Error)
+	if !ok {
+		t.Fatalf("ExecutePartitions: error %v is not an adbc.Error", err)
+	}
+	if adbcErr.Code != adbc.StatusInvalidState {
+		t.Fatalf("ExecutePartitions: code = %v, want StatusInvalidState", adbcErr.Code)
+	}
+	if partitions.NumPartitions != 0 || len(partitions.PartitionIDs) != 0 {
+		t.Fatalf("ExecutePartitions: expected no partitions on refusal, got %+v", partitions)
+	}
+	if rows != -1 {
+		t.Fatalf("ExecutePartitions: rows = %d, want -1", rows)
+	}
+}
