---
source: crates/sutura-cli/tests/served/duckdb.rs
expression: "body[\"executions\"]"
---
- kind: datafusion
  source: local
  stage: files
  logical_plan: "Limit: skip=0, fetch=10001\n  Sort: period ASC NULLS LAST\n    Projection: period AS period, recurring_revenue AS recurring_revenue, data_per_subscription AS data_per_subscription\n      Aggregate: groupBy=[[period]], aggr=[[max(recurring_revenue) AS recurring_revenue, max(data_per_subscription) AS data_per_subscription]]\n        Union\n          Projection: period, recurring_revenue, Float64(NULL) AS data_per_subscription\n            Projection: date_trunc(Utf8(\"month\"),fct_subscription_monthly.month) AS period, sum(fct_subscription_monthly.mrr_cents) AS recurring_revenue\n              Aggregate: groupBy=[[CAST(date_trunc(Utf8(\"month\"), fct_subscription_monthly.month) AS Date32)]], aggr=[[sum(fct_subscription_monthly.mrr_cents)]]\n                Filter: fct_subscription_monthly.month >= Date32(\"2026-06-01\") AND fct_subscription_monthly.month < Date32(\"2026-07-01\") AND fct_subscription_monthly.status = Utf8(\"active\")\n                  TableScan: fct_subscription_monthly\n          Projection: period, Int64(NULL) AS recurring_revenue, data_per_subscription\n            Projection: date_trunc(Utf8(\"month\"),fct_usage_daily.usage_date) AS period, sum(fct_usage_daily.data_gb) / nullif(count(DISTINCT fct_usage_daily.subscription_key),Float64(0)) AS data_per_subscription\n              Aggregate: groupBy=[[CAST(date_trunc(Utf8(\"month\"), fct_usage_daily.usage_date) AS Date32)]], aggr=[[CAST(sum(fct_usage_daily.data_gb) AS Float64) / nullif(CAST(count(DISTINCT fct_usage_daily.subscription_key) AS Float64), Float64(0))]]\n                Filter: fct_usage_daily.usage_date >= Date32(\"2026-06-01\") AND fct_usage_daily.usage_date < Date32(\"2026-07-01\")\n                  TableScan: fct_usage_daily"
