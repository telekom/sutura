---
source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT "dim_customer"."region" AS "region", "dim_product"."product_family" AS "product_family", CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) AS "period", if(toTypeName(sum("fct_subscription_monthly"."mrr_cents")) IN ('Int64', 'Nullable(Int64)', 'UInt64', 'Nullable(UInt64)', 'Int128', 'Nullable(Int128)'), tuple('Int128', toDecimal256(sum(accurateCastOrNull("fct_subscription_monthly"."mrr_cents", 'Int128')), 0), CAST(NULL AS Nullable(Decimal(76, 38))), CAST(NULL AS Nullable(Float64))), tuple(toTypeName(sum("fct_subscription_monthly"."mrr_cents")), CAST(NULL AS Nullable(Decimal(76, 0))), if(toTypeName(sum("fct_subscription_monthly"."mrr_cents")) LIKE '%Decimal(%', toDecimal256(sum("fct_subscription_monthly"."mrr_cents"), 38), NULL), if(toTypeName(sum("fct_subscription_monthly"."mrr_cents")) LIKE '%Float%', toFloat64(sum("fct_subscription_monthly"."mrr_cents")), NULL))) AS "recurring_revenue" FROM "fct_subscription_monthly" LEFT JOIN "dim_customer" ON "fct_subscription_monthly"."customer_key" = "dim_customer"."customer_key" LEFT JOIN "dim_product" ON "fct_subscription_monthly"."product_key" = "dim_product"."product_key" WHERE "fct_subscription_monthly"."month" >= ? AND "fct_subscription_monthly"."month" < ? AND "fct_subscription_monthly"."status" = ? GROUP BY "dim_customer"."region", "dim_product"."product_family", CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) ORDER BY "dim_customer"."region", "dim_product"."product_family", CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) LIMIT 10001
