SELECT `dim_product`.`product_name` AS `product_name`, CAST(DATE_TRUNC(`fct_subscription_monthly`.`month`, MONTH) AS DATE) AS `period`, sum(`fct_subscription_monthly`.`mrr_cents`) AS `recurring_revenue` FROM `fct_subscription_monthly` LEFT JOIN `dim_product` ON `fct_subscription_monthly`.`product_key` = `dim_product`.`product_key` WHERE `fct_subscription_monthly`.`month` >= ? AND `fct_subscription_monthly`.`month` < ? AND `fct_subscription_monthly`.`status` = ? GROUP BY `dim_product`.`product_name`, CAST(DATE_TRUNC(`fct_subscription_monthly`.`month`, MONTH) AS DATE) ORDER BY `dim_product`.`product_name` NULLS LAST, CAST(DATE_TRUNC(`fct_subscription_monthly`.`month`, MONTH) AS DATE) NULLS LAST LIMIT 10001
