+type googleEndpointRecorder struct {
+	t         *testing.T
+	hosts     []string
+	delegated bool
+}
+
+func (r *googleEndpointRecorder) RoundTrip(request *http.Request) (*http.Response, error) {
+	r.hosts = append(r.hosts, request.URL.Hostname())
+	body := ""
+	switch request.URL.Hostname() {
+	case "iamcredentials-example.p.googleapis.com":
+		if !strings.HasSuffix(request.URL.Path, ":signJwt") || request.Header.Get("Authorization") != "Bearer deployment-token" {
+			r.t.Fatalf("unexpected signJwt request: %s, auth %q", request.URL, request.Header.Get("Authorization"))
+		}
+		body = `{"signedJwt":"signed-assertion"}`
+	case "oauth2-example.p.googleapis.com":
+		if request.URL.Path != "/token" {
+			r.t.Fatalf("token path %q", request.URL.Path)
+		}
+		payload, _ := io.ReadAll(request.Body)
+		if !strings.Contains(string(payload), "signed-assertion") {
+			r.t.Fatalf("OAuth exchange lost signed JWT: %s", payload)
+		}
+		r.delegated = true
+		body = `{"access_token":"delegated-token","token_type":"Bearer","expires_in":3600}`
+	case "sts-example.p.googleapis.com":
+		if request.URL.Path != "/v1/token" {
+			r.t.Fatalf("STS path %q", request.URL.Path)
+		}
+		body = `{"access_token":"deployment-token","token_type":"Bearer","expires_in":3600,"issued_token_type":"urn:ietf:params:oauth:token-type:access_token"}`
+	case "bigquery-example.p.googleapis.com":
+		want := "Bearer caller-token"
+		if r.delegated {
+			want = "Bearer delegated-token"
+		}
+		if request.Header.Get("Authorization") != want {
+			r.t.Fatalf("query auth %q, want %q", request.Header.Get("Authorization"), want)
+		}
+		body = `{"jobComplete":true,"jobReference":{"projectId":"test-project","jobId":"endpoint-job","location":"US"},"schema":{"fields":[{"name":"n","type":"INTEGER"}]},"totalRows":"1","rows":[{"f":[{"v":"1"}]}]}`
+	default:
+		r.t.Fatalf("default or undeclared Google host dialled: %s", request.URL)
+	}
+	return &http.Response{StatusCode: http.StatusOK, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(strings.NewReader(body)), Request: request}, nil
+}
+
+func googleTLSFixture(t *testing.T) (string, string, string, *x509.CertPool) {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{SerialNumber: big.NewInt(1), NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign | x509.KeyUsageDigitalSignature}
+	certificate, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pemCertificate := pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: certificate})
+	encodedKey, err := x509.MarshalPKCS8PrivateKey(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	dir := t.TempDir()
+	ca, cert, privateKey := filepath.Join(dir, "ca.pem"), filepath.Join(dir, "client.pem"), filepath.Join(dir, "client.key")
+	for path, data := range map[string][]byte{ca: pemCertificate, cert: pemCertificate, privateKey: pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: encodedKey})} {
+		if err := os.WriteFile(path, data, 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	roots := x509.NewCertPool()
+	roots.AppendCertsFromPEM(pemCertificate)
+	return ca, cert, privateKey, roots
+}
+
+func TestGooglePrivateEndpointsEveryIdentity(t *testing.T) {
