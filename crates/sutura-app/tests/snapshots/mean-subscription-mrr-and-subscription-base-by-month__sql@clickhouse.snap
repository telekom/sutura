---
source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) AS "period", avg(CASE WHEN "fct_subscription_monthly"."status" = ? THEN "fct_subscription_monthly"."mrr_cents" END) AS "mean_subscription_mrr", COUNT(DISTINCT "fct_subscription_monthly"."subscription_key") AS "subscription_base" FROM "fct_subscription_monthly" WHERE "fct_subscription_monthly"."month" >= ? AND "fct_subscription_monthly"."month" < ? GROUP BY CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) ORDER BY CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) LIMIT 10001
