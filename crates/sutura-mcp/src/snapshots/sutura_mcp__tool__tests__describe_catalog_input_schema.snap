{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "This tool returns the catalog of what this deployment measures, narrowed to what the calling\nprincipal may see - the metrics, grains, dimensions and permitted values.\n\n`model` is optional and narrows the answer to one named model: only the metrics tied to it, and -\nwhere the operator exposes physical schema - only that model's own columns and relationships.\n`metric` is optional and narrows the answer to that one metric alone, naming nothing about its\nmodel's physical schema - the way to read back a single metric a previous, byte-bounded listing\nnamed but left out. Give at most one of `model` and `metric`; both together is refused. Omit\nboth for the whole catalog. An unfiltered catalog whose metrics or physical schema would be\nlarge is itself capped at a byte bound shared across the whole result; where it is, every item\nleft out is named explicitly up to [`sutura_app::catalog_budget::MAX_OMITTED_NAMES`] names,\nalong with how to read it back - call this tool again with `model` or `metric` set to one of\nthose names.\n\n`model_prefix` narrows the listing (or the names index below) to model names starting with that\nprefix, for when only part of a name is known. Mutually exclusive with `model` and `metric`.\n\n`names: true` switches this tool to a names-only index of every visible model AND every visible\nmetric - name and table for a model, name and owning model for a metric, nothing else - walked as\none sequential stream (every model, in order, then every metric) under the same byte bound and\nNOT subject to the omission list's own cap on how many names it carries. Once a page does not\ncover every remaining name, the result carries a `next` cursor; call this tool again with\n`after` set to that cursor, verbatim, to continue. `next` is absent only once BOTH halves are\nexhausted. This is how every model or metric past that cap is reached, not only the first page\nof them. Mutually exclusive with `model` and `metric`; `after` is only meaningful alongside\n`names: true`, and a value this tool did not itself return is refused.\n\nThis tool also returns the catalog's own knowledge (the glossary, caveats, worked examples and\nterms recorded as undefined it carries) and the deployment operator's instructions - neither is\nscoped to one model or metric, so none of these arguments narrow them.",
  "properties": {
    "after": {
      "description": "Resumes a `names: true` index at the point the previous call left off - pass the `next`\ncursor that call returned, verbatim. Refused unless `names` is also `true`, and refused if it\ndoes not parse as a cursor this tool itself produced.",
      "type": [
        "string",
        "null"
      ]
    },
    "metric": {
      "description": "One metric's own name, to read back exactly that metric's entry - nothing about its model's\nphysical schema. Omit it for the whole catalog. Mutually exclusive with `model`,\n`model_prefix` and `names`.",
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "description": "The model's own name - the same identifier its physical schema prints as `model <name>`.\nOmit it for the whole catalog. Mutually exclusive with `metric`, `model_prefix` and `names`.",
      "type": [
        "string",
        "null"
      ]
    },
    "model_prefix": {
      "description": "Narrows the listing, or the `names` index, to model names starting with this prefix.\nMutually exclusive with `model` and `metric`. Refused if given empty.",
      "type": [
        "string",
        "null"
      ]
    },
    "names": {
      "description": "`true` switches this tool to a names-only, paged index of every visible model AND every\nvisible metric - see this type's own doc for how to page through it with `after`. Mutually\nexclusive with `model` and `metric`.",
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "title": "DescribeCatalogArgs",
  "type": "object"
}
