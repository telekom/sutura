---
source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT CAST(TRUNC("fct_usage_daily"."usage_date", 'IW') AS DATE) AS "period", TO_BINARY_DOUBLE(SUM("fct_usage_daily"."data_gb")) / NULLIF(COUNT(DISTINCT "fct_usage_daily"."subscription_key"), 0) AS "data_per_subscription" FROM "fct_usage_daily" WHERE "fct_usage_daily"."usage_date" >= :1 AND "fct_usage_daily"."usage_date" < :2 GROUP BY CAST(TRUNC("fct_usage_daily"."usage_date", 'IW') AS DATE) ORDER BY CAST(TRUNC("fct_usage_daily"."usage_date", 'IW') AS DATE) FETCH FIRST 10001 ROWS ONLY
