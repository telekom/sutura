+func TestGoogleTLSMaterialRefusesPartialBundles(t *testing.T) {
+	ca, cert, key, _ := googleTLSFixture(t)
+	valid, err := os.ReadFile(ca)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, suffix := range []string{"not a certificate", "-----BEGIN CERTIFICATE-----\nbroken\n-----END CERTIFICATE-----\n", "-----BEGIN CERTIFICATE-----\nbroken\n"} {
+		for _, before := range []bool{false, true} {
+			data := append(append([]byte{}, valid...), []byte(suffix)...)
+			if before {
+				data = append([]byte(suffix), valid...)
+			}
+			invalid := filepath.Join(t.TempDir(), "invalid.pem")
+			if err := os.WriteFile(invalid, data, 0600); err != nil {
+				t.Fatal(err)
+			}
+			for _, declaration := range []googleDestinations{{caFile: invalid}, {certFile: invalid, keyFile: key}} {
+				if _, err := declaration.tlsConfig(); err == nil {
+					t.Fatalf("partial bundle accepted: suffix %q before %v", suffix, before)
+				}
+			}
+		}
+	}
+	keyData, err := os.ReadFile(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	badKey := filepath.Join(t.TempDir(), "key.pem")
+	if err := os.WriteFile(badKey, append(keyData, []byte("broken trailing key")...), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := (googleDestinations{certFile: cert, keyFile: badKey}).tlsConfig(); err == nil {
+		t.Fatal("partial key accepted")
+	}
+}
