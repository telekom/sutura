--- a/crates/sutura-cli/Cargo.toml
+++ b/crates/sutura-cli/Cargo.toml
@@ -114,6 +114,9 @@ openmetadata = ["dep:sutura-catalog-openmetadata", "sutura-catalog-openmetadata/
 # `openmetadata`'s reason: its outbound TLS stack arrives through `sutura-http-client`, which also
