+func TestGoogleCredentialRedirectsRefused(t *testing.T) {
+	for _, status := range []int{http.StatusTemporaryRedirect, http.StatusPermanentRedirect} {
+		for _, authenticated := range []bool{false, true} {
+			recorder := &googleRedirectTransport{status: status}
+			client := googleHTTPClient(recorder)
+			if authenticated {
+				var err error
+				client, err = googleAuthenticatedClient(context.Background(), recorder, []option.ClientOption{option.WithTokenSource(oauth2.StaticTokenSource(&oauth2.Token{AccessToken: "caller-token"}))})
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			request, err := http.NewRequest("POST", "https://oauth2-example.p.googleapis.com/token", strings.NewReader("assertion=secret-fixture"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			response, err := client.Do(request)
+			if response != nil {
+				response.Body.Close()
+			}
+			if err == nil || !strings.Contains(err.Error(), "redirects are refused") || recorder.calls != 1 {
+				t.Fatalf("redirect status %d authenticated %v: calls=%d err=%v", status, authenticated, recorder.calls, err)
+			}
+		}
+	}
+}
