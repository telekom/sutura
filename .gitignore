/target
**/*.rs.bk
*.pdb

# pixi manages the Python environment; the materialised env is not source.
/.pixi
__pycache__/

# Local editor / OS noise
.idea/
.vscode/
.DS_Store

# Nix / devenv / direnv
/result
/result-*
.direnv/
.devenv/
.devenv.flake.nix
# Personal, uncommitted devenv overrides - the escape hatch that stops people
# editing devenv.nix to make their own machine work.
devenv.local.nix

# prek / pre-commit hook caches
.pre-commit-cache/
.prek-cache/

# Mirror/proxy values for a network without direct egress. Deliberately NOT committed:
# the repo carries public defaults, the site-specific routing stays out of it.
.env

# Ponytail activation flag: local, per-developer.
.ponytail-active

# The compose tier's per-worktree state: the discovery file `xtask dev-up` writes, and the lock it
# holds across a provision or a teardown. Deliberately NOT committed and deliberately inside the
# worktree rather than in a shared directory - the endpoints in it are the ports docker allocated
# for THIS worktree on THIS run, so a committed copy would be a constant, which is the one thing
# discovery exists to make unavailable.
.sutura-dev/

# The rendered site. `mkdocs build` writes it; the markdown in docs/ is the source.
/site

# The CRAP delta's working files: this commit's baseline lifted out of the Nix store, the base
# commit's downloaded artifact, and the rendered pull-request comment. `.github/workflows/ci.yml`
# writes all three into the workspace and `just crap-delta` can too; none of them is source, and
# the committed one would rot the moment anything changed.
/crap-baseline.json
/crap-base/
/crap-delta.md
