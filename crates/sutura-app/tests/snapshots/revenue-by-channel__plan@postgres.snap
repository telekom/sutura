source: local
metric: revenue
table: orders
joins: []
bucket:
  label: period
  grain: month
  column:
    table: orders
    column: order_date
keys:
  - label: channel
    column:
      table: orders
      column: channel
measure:
  label: revenue
  aggregate: sum
  column:
    table: orders
    column: amount_cents
time_column:
  table: orders
  column: order_date
start_param: 0
end_param: 1
filters: []
params:
