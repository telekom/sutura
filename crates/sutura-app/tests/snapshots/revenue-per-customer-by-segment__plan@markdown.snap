---
source: crates/sutura-app/tests/golden/catalogs.rs
expression: plan
---
source: local
measures:
  - metric: revenue_per_customer
    label: revenue_per_customer
    measure:
      ratio:
        numerator:
          aggregate:
            aggregate: sum
            column:
              table: fct_subscription_monthly
              column: mrr_cents
        denominator:
          aggregate:
            aggregate: count_distinct
            column:
              table: fct_subscription_monthly
              column: customer_key
        zero_denominator: yields_null
    guard: []
table: fct_subscription_monthly
joins:
  - relationship: subscription_customer
    table: dim_customer
    join_type: many_to_one
    keys:
      - Equal:
          origin:
            table: fct_subscription_monthly
            column: customer_key
          target:
            table: dim_customer
            column: customer_key
bucket:
  label: period
  grain: month
  column:
    table: fct_subscription_monthly
    column: month
keys:
  - label: segment
    column:
      table: dim_customer
      column: segment
filters:
  - origin: definition
    predicate:
      at_or_after:
        column:
          table: fct_subscription_monthly
          column: month
        param: 0
  - origin: definition
    predicate:
      before:
        column:
          table: fct_subscription_monthly
          column: month
        param: 1
  - origin: definition
    predicate:
      equals:
        column:
          table: fct_subscription_monthly
          column: status
        param: 2
params:
  - Date: 2026-06-01
  - Date: 2026-07-01
  - Text: active
range:
  start: 2026-06-01
  end: 2026-07-01
max_rows: 10000
top: ~
