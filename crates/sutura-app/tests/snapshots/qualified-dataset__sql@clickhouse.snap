---
source: crates/sutura-app/tests/golden/qualified.rs
expression: query.sql()
---
SELECT CAST(dateTrunc('month', "orders"."order_date") AS DATE) AS "period", if(toTypeName(sum("orders"."amount_cents")) IN ('Int64', 'Nullable(Int64)', 'UInt64', 'Nullable(UInt64)', 'Int128', 'Nullable(Int128)'), tuple('Int128', toDecimal256(sum(accurateCastOrNull("orders"."amount_cents", 'Int128')), 0), CAST(NULL AS Nullable(Decimal(76, 38))), CAST(NULL AS Nullable(Float64))), tuple(toTypeName(sum("orders"."amount_cents")), CAST(NULL AS Nullable(Decimal(76, 0))), if(toTypeName(sum("orders"."amount_cents")) LIKE '%Decimal(%', toDecimal256(sum("orders"."amount_cents"), 38), NULL), if(toTypeName(sum("orders"."amount_cents")) LIKE '%Float%', toFloat64(sum("orders"."amount_cents")), NULL))) AS "revenue" FROM "sales"."orders" WHERE "orders"."order_date" >= ? AND "orders"."order_date" < ? GROUP BY CAST(dateTrunc('month', "orders"."order_date") AS DATE) ORDER BY CAST(dateTrunc('month', "orders"."order_date") AS DATE) LIMIT 10001
