---
source: crates/sutura-cli/tests/example.rs
expression: rendered(&query)
---
SELECT "dim_customer"."segment" AS "segment", CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) AS "period", CAST(SUM("fct_subscription_monthly"."mrr_cents") AS DOUBLE) / NULLIF(COUNT(DISTINCT "fct_subscription_monthly"."customer_key"), 0) AS "revenue_per_customer" FROM "fct_subscription_monthly" LEFT JOIN "dim_customer" ON "fct_subscription_monthly"."customer_key" = "dim_customer"."customer_key" WHERE "fct_subscription_monthly"."month" >= ? AND "fct_subscription_monthly"."month" < ? AND "fct_subscription_monthly"."status" = ? GROUP BY "dim_customer"."segment", CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) ORDER BY "dim_customer"."segment", CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) LIMIT 10001
-- $1 = 2026-06-01
-- $2 = 2026-07-01
-- $3 = "active"
