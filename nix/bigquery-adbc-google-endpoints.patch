+			}
+			if err := statement.SetSqlQuery(ctx, "SELECT 1 AS n"); err != nil {
+				t.Fatal(err)
+			}
+			rows, _, err := statement.ExecuteQuery(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer rows.Release()
+			if len(rows.Schema().Fields()) != 1 {
+				t.Fatalf("dry-run query lost its schema: %v", rows.Schema())
+			}
+			want := []string{"bigquery-example.p.googleapis.com"}
+			if mode == "domain_delegation" {
+				want = []string{"sts-example.p.googleapis.com", "iamcredentials-example.p.googleapis.com", "oauth2-example.p.googleapis.com", "bigquery-example.p.googleapis.com"}
+			}
+			if !reflect.DeepEqual(recorder.hosts, want) {
+				t.Fatalf("hosts %v, want %v", recorder.hosts, want)
+			}
+		})
+	}
+}
