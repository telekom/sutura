---
source: crates/sutura-app/tests/golden/qualified.rs
expression: query.sql()
---
SELECT CAST(dateTrunc('month', "orders"."order_date") AS DATE) AS "period", if(toTypeName(sum("orders"."amount_cents")) IN ('Int64', 'UInt64', 'Nullable(Int64)', 'Nullable(UInt64)'), tuple('Int128', CAST(sum(accurateCastOrNull("orders"."amount_cents", 'Int128')) AS Dynamic)), tuple(toTypeName(sum("orders"."amount_cents")), CAST(sum("orders"."amount_cents") AS Dynamic))) AS "revenue" FROM "sales"."orders" WHERE "orders"."order_date" >= ? AND "orders"."order_date" < ? GROUP BY CAST(dateTrunc('month', "orders"."order_date") AS DATE) ORDER BY CAST(dateTrunc('month', "orders"."order_date") AS DATE) LIMIT 10001
