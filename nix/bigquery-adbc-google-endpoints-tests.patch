+func TestGooglePrivateEndpointsEveryIdentity(t *testing.T) {
+	ca, cert, key, roots := googleTLSFixture(t)
+	for _, mode := range []string{"workload_identity", "google_login", "domain_delegation"} {
+		t.Run(mode, func(t *testing.T) {
+			recorder := &googleEndpointRecorder{}
+			assertRequests := func() {
+				delegated := false
+				for _, request := range recorder.requests {
+					switch request.host {
+					case "iamcredentials-example.p.googleapis.com":
+						if !strings.HasSuffix(request.path, ":signJwt") || request.authorization != "Bearer deployment-token" {
+							t.Fatalf("unexpected signJwt request: %s, auth %q", request.path, request.authorization)
+						}
+					case "oauth2-example.p.googleapis.com":
+						if request.path != "/token" {
+							t.Fatalf("token path %q", request.path)
+						}
+						if !strings.Contains(request.body, "signed-assertion") {
+							t.Fatalf("OAuth exchange lost signed JWT: %s", request.body)
+						}
+						delegated = true
+					case "sts-example.p.googleapis.com":
+						if request.path != "/v1/token" {
+							t.Fatalf("STS path %q", request.path)
+						}
+					case "bigquery-example.p.googleapis.com":
+						want := "Bearer caller-token"
+						if delegated {
+							want = "Bearer delegated-token"
+						}
+						if request.authorization != want {
+							t.Fatalf("query auth %q, want %q", request.authorization, want)
+						}
+					default:
+						t.Fatalf("default or undeclared Google host dialled: %s", request.host)
+					}
+				}
+			}
+			oldBase, oldDetect := googleBaseTransport, detectGoogleCredentials
+			defer func() { googleBaseTransport, detectGoogleCredentials = oldBase, oldDetect }()
+			googleBaseTransport = func(config *tls.Config) http.RoundTripper {
+				if config.InsecureSkipVerify || config.MinVersion < tls.VersionTLS12 {
+					t.Fatal("Google transport stopped verifying TLS")
+				}
+				if config.RootCAs == nil || !config.RootCAs.Equal(roots) || len(config.Certificates) != 1 {
+					t.Fatal("declared roots must replace system roots, and client identity must reach the transport")
+				}
+				return recorder
+			}
+			detectGoogleCredentials = func(opts *authcredentials.DetectOptions) (*auth.Credentials, error) {
+				// The ADC exchange must share the configured STS routing, not acquire a public transport.
+				request, _ := http.NewRequest("POST", "https://sts.googleapis.com/v1/token", strings.NewReader("subject_token=base-assertion"))
+				response, err := opts.Client.Do(request)
+				if err != nil {
+					return nil, err
+				}
+				response.Body.Close()
+				return auth.NewCredentials(&auth.CredentialsOptions{TokenProvider: oauth2adapt.TokenProviderFromTokenSource(oauth2.StaticTokenSource(&oauth2.Token{AccessToken: "deployment-token", Expiry: time.Now().Add(time.Hour)}))}), nil
+			}
+			opts := map[string]string{
+				"bigquery.tls.ca_file":              ca,
+				"bigquery.tls.cert_file":            cert,
+				"bigquery.tls.key_file":             key,
+				"bigquery.project_id":               "test-project",
+				"bigquery.endpoint":                 "https://bigquery-example.p.googleapis.com/bigquery/v2/",
+				"bigquery.storage_endpoint":         "bigquerystorage-example.p.googleapis.com:443",
+				"bigquery.iam_credentials_endpoint": "https://iamcredentials-example.p.googleapis.com/",
+				"bigquery.oauth_token_endpoint":     "https://oauth2-example.p.googleapis.com/token",
+				"bigquery.sts_endpoint":             "https://sts-example.p.googleapis.com/v1/token",
+				"bigquery.query.through_jobs_query": "true",
