+
+// OptionQueryThroughJobsQuery, set to "true" on the database, starts a statement
+// run by ExecuteQuery or ExecuteUpdate with jobs.query instead of jobs.insert;
+// ExecuteSchema's dry run and the session and transaction statements still use
+// jobs.insert. Google accepts jobs.query, jobs.get,
+// jobs.getQueryResults and the Storage Read API from a token scoped to
+// bigquery.readonly, and refuses it jobs.insert and jobs.cancel. jobs.query takes
+// no client-chosen job ID, so a statement cut off before jobs.query answers
+// cannot cancel its job.
+const OptionQueryThroughJobsQuery = "bigquery.query.through_jobs_query"
+
+// jobsQueryFields are the jobs.insert configuration fields that jobs.query takes
+// under the same name and meaning. Any other field is refused, never dropped.
+var jobsQueryFields = map[string]bool{
+	"connectionProperties": true,
+	"createSession":        true,
+	"defaultDataset":       true,
+	"dryRun":               true,
+	"jobTimeoutMs":         true,
+	"labels":               true,
+	"maxSlots":             true,
+	"maximumBytesBilled":   true,
+	"query":                true,
+	"queryParameters":      true,
+	"reservation":          true,
+	"useLegacySql":         true,
+	"useQueryCache":        true,
+}
+
+var errRendered = errors.New("[bq] jobs.insert request rendered, not sent")
+
+// renderTransport keeps the one request it is given and sends nothing.
+type renderTransport struct{ body []byte }
+
+func (t *renderTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	defer r.Body.Close()
+	body, err := io.ReadAll(r.Body)
+	if err != nil {
+		return nil, err
+	}
+	t.body = body
+	return nil, errRendered
+}
+
+// queryRequest renders query with the client library's own encoder, so its
+// parameters and options reach jobs.query as jobs.insert would have carried
+// them. The rendering client holds no credential and its transport sends nothing.
+func queryRequest(ctx context.Context, query *bigquery.Query, project, location string) (*bq.QueryRequest, error) {
+	rendered := &renderTransport{}
+	client, err := bigquery.NewClient(ctx, project, option.WithHTTPClient(&http.Client{Transport: rendered}))
+	if err != nil {
+		return nil, err
+	}
+	defer client.Close()
+	client.Location = location
+	q := client.Query(query.Q)
+	q.QueryConfig = query.QueryConfig
+	if _, err := q.Run(ctx); !errors.Is(err, errRendered) {
+		return nil, fmt.Errorf("render jobs.insert request: %w", err)
+	}
+
+	var job struct {
+		JobReference  bq.JobReference            `json:"jobReference"`
+		Configuration map[string]json.RawMessage `json:"configuration"`
+	}
+	if err := json.Unmarshal(rendered.body, &job); err != nil {
+		return nil, err
+	}
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(job.Configuration["query"], &fields); err != nil {
+		return nil, err
+	}
+	delete(job.Configuration, "query")
+	maps.Copy(fields, job.Configuration)
+	for _, name := range slices.Sorted(maps.Keys(fields)) {
+		if !jobsQueryFields[name] {
+			return nil, adbc.Error{
+				Code: adbc.StatusNotImplemented,
+				Msg:  fmt.Sprintf("[bq] `%s` cannot run through jobs.query (`%s`)", name, OptionQueryThroughJobsQuery),
+			}
+		}
+	}
+	body, err := json.Marshal(fields)
+	if err != nil {
+		return nil, err
+	}
+	req := &bq.QueryRequest{}
+	if err := json.Unmarshal(body, req); err != nil {
+		return nil, err
+	}
+	req.Location = job.JobReference.Location
+	req.RequestId = uuid.NewV7().String()
+	return req, nil
+}
+
+// runThroughJobsQuery is runQuery with the job started by jobs.query.
+func runThroughJobsQuery(ctx context.Context, logger *slog.Logger, query *bigquery.Query, executeUpdate bool, st *statement) (bigquery.ArrowIterator, schemaEnhancer, string, int64, error) {
+	client := st.cnxn.client
+	req, err := queryRequest(ctx, query, client.Project(), client.Location)
+	if err != nil {
+		return nil, nil, "", -1, errToAdbcErr(adbc.StatusInvalidArgument, err, "render query")
+	}
+	resp, err := st.cnxn.service.Jobs.Query(client.Project(), req).Context(ctx).Do()
+	if err != nil {
+		return nil, nil, "", -1, errToAdbcErr(adbc.StatusInternal, err, "run query")
+	}
+	if req.DryRun {
+		js, err := dryRunStatus(resp)
+		if err != nil {
+			return nil, nil, "", -1, errToAdbcErr(adbc.StatusInternal, err, "read dry run schema")
+		}
+		it, err := newDryRunArrowIterator(js.Statistics, "")
+		if err != nil {
+			return nil, nil, "", -1, errToAdbcErr(adbc.StatusInternal, err, "create dry run Arrow iterator")
+		}
+		return it, &jobStatisticsSchemaEnhancer{stats: js.Statistics}, "", resp.TotalBytesProcessed, nil
+	}
+	ref := resp.JobReference
+	if ref == nil || ref.JobId == "" {
+		return nil, nil, "", -1, adbc.Error{Code: adbc.StatusInternal, Msg: "[bq] jobs.query answered without a job"}
+	}
+
+	activeJob := newJobCancellation(ref.JobId, func(ctx context.Context) (jobCanceler, error) {
+		return client.JobFromProject(ctx, ref.ProjectId, ref.JobId, ref.Location)
+	})
+	st.cancelMu.Lock()
+	st.activeJob = activeJob
+	st.cancelMu.Unlock()
+	defer st.finishJob(ctx, logger, activeJob)
+
+	job, err := client.JobFromProject(ctx, ref.ProjectId, ref.JobId, ref.Location)
+	if err != nil {
+		return nil, nil, ref.JobId, -1, errToAdbcErr(adbc.StatusInternal, err, "get job")
+	}
+	activeJob.setJob(job)
+	return readJob(ctx, logger, client, query, executeUpdate, job, activeJob, nil, false)
+}
+
+// dryRunStatus is the status a jobs.insert dry run reports; jobs.query creates no job for one.
+func dryRunStatus(resp *bq.QueryResponse) (*bigquery.JobStatus, error) {
+	stats := &bigquery.QueryStatistics{StatementType: resp.StatementType, TotalBytesProcessed: resp.TotalBytesProcessed}
+	if resp.Schema != nil && len(resp.Schema.Fields) > 0 {
+		fields, err := json.Marshal(resp.Schema.Fields)
+		if err != nil {
+			return nil, err
+		}
+		if stats.Schema, err = bigquery.SchemaFromJSON(fields); err != nil {
+			return nil, err
+		}
+	}
+	return &bigquery.JobStatus{
+		State:      bigquery.Done,
+		Statistics: &bigquery.JobStatistics{TotalBytesProcessed: resp.TotalBytesProcessed, Details: stats},
+	}, nil
+}
