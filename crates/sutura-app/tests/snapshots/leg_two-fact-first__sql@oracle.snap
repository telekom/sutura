---
source: crates/sutura-app/tests/golden/legs.rs
expression: query.sql()
---
SELECT "fct_subscription_monthly"."customer_key" AS "0_link", CAST(TRUNC("dim_calendar"."month", 'MM') AS DATE) AS "period", COUNT("fct_subscription_monthly"."subscription_key") AS "0_leaf_1" FROM "fct_subscription_monthly" LEFT JOIN "dim_calendar" ON "fct_subscription_monthly"."month" = "dim_calendar"."month" WHERE "dim_calendar"."month" >= :1 AND "dim_calendar"."month" < :2 GROUP BY "fct_subscription_monthly"."customer_key", CAST(TRUNC("dim_calendar"."month", 'MM') AS DATE) ORDER BY "fct_subscription_monthly"."customer_key", CAST(TRUNC("dim_calendar"."month", 'MM') AS DATE)
