+// BigQuery refuses per-request serialization options on a session stream with
+// InvalidArgument ("Arrow serialization options are only supported for job
+// streams"), so ReadPartition must send none.
+func TestPartitionReadSendsNoRequestSerializationOptions(t *testing.T) {
+	client, fake := clientOfFakeStorageRead(t)
+	streamName := "projects/p/locations/us/sessions/s1/streams/stream-0"
+
+	if _, err := readPartitionRecordReader(context.Background(), client, streamName, memory.DefaultAllocator, 1); err == nil {
+		t.Fatal("readPartitionRecordReader: the fake refuses every read, got no error")
+	}
+	req := recorded(t, fake.reads)
+	if req.GetReadStream() != streamName {
+		t.Fatalf("ReadRows stream = %q, want %q", req.GetReadStream(), streamName)
+	}
+	if opts := req.GetOutputFormatSerializationOptions(); opts != nil {
+		t.Fatalf("ReadRows on a session stream carries serialization options %v; BigQuery accepts them only on a job stream", opts)
+	}
+}
+
+// The session, not the read, carries the compression, and its preferred minimum
+// equals its maximum, so a small table is still asked to split that far.
+func TestPartitionReadSessionCompressesAndAsksForAMinimum(t *testing.T) {
+	client, fake := clientOfFakeStorageRead(t)
+
+	if _, _, err := createPartitionReadSession(context.Background(), client, client.Dataset("d").Table("t"), 2); err == nil {
+		t.Fatal("createPartitionReadSession: the fake refuses every session, got no error")
+	}
+	req := recorded(t, fake.sessions)
+	if got := req.GetReadSession().GetTable(); got != "projects/p/datasets/d/tables/t" {
+		t.Fatalf("session table = %q", got)
+	}
+	if got := req.GetReadSession().GetReadOptions().GetArrowSerializationOptions().GetBufferCompression(); got != storagepb.ArrowSerializationOptions_ZSTD {
+		t.Fatalf("session buffer compression = %v, want ZSTD", got)
+	}
+	if req.GetMaxStreamCount() != 2 || req.GetPreferredMinStreamCount() != 2 {
+		t.Fatalf("session stream counts max=%d preferred_min=%d, want 2 and 2", req.GetMaxStreamCount(), req.GetPreferredMinStreamCount())
+	}
+}
