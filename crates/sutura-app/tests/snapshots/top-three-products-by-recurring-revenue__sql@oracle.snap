---
source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT "dim_product"."product_name" AS "product_name", CAST(TRUNC("fct_subscription_monthly"."month", 'MM') AS DATE) AS "period", SUM("fct_subscription_monthly"."mrr_cents") AS "recurring_revenue" FROM "fct_subscription_monthly" LEFT JOIN "dim_product" ON "fct_subscription_monthly"."product_key" = "dim_product"."product_key" WHERE "fct_subscription_monthly"."month" >= :1 AND "fct_subscription_monthly"."month" < :2 AND "fct_subscription_monthly"."status" = :3 GROUP BY "dim_product"."product_name", CAST(TRUNC("fct_subscription_monthly"."month", 'MM') AS DATE) ORDER BY SUM("fct_subscription_monthly"."mrr_cents") DESC NULLS LAST, "dim_product"."product_name", CAST(TRUNC("fct_subscription_monthly"."month", 'MM') AS DATE) FETCH FIRST 3 ROWS ONLY
