---
source: crates/sutura-app/tests/golden/legs.rs
expression: query.sql()
---
SELECT "dim_monthly"."product_family" AS "product_family", CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) AS "period", if(toTypeName(sum("fct_subscription_monthly"."voice_min")) IN ('Int64', 'Nullable(Int64)', 'UInt64', 'Nullable(UInt64)', 'Int128', 'Nullable(Int128)'), tuple('Int128', toDecimal256(sum(accurateCastOrNull("fct_subscription_monthly"."voice_min", 'Int128')), 0), CAST(NULL AS Nullable(Decimal(76, 38))), CAST(NULL AS Nullable(Float64))), tuple(toTypeName(sum("fct_subscription_monthly"."voice_min")), CAST(NULL AS Nullable(Decimal(76, 0))), if(toTypeName(sum("fct_subscription_monthly"."voice_min")) LIKE '%Decimal(%', toDecimal256(sum("fct_subscription_monthly"."voice_min"), 38), NULL), if(toTypeName(sum("fct_subscription_monthly"."voice_min")) LIKE '%Float%', toFloat64(sum("fct_subscription_monthly"."voice_min")), NULL))) AS "0_leaf_0" FROM "fct_subscription_monthly" LEFT JOIN "dim_monthly" ON "fct_subscription_monthly"."subscription_key" = "dim_monthly"."subscription_key" AND CAST(dateTrunc('month', "fct_subscription_monthly"."usage_date") AS DATE) = "dim_monthly"."month" WHERE "fct_subscription_monthly"."month" >= ? AND "fct_subscription_monthly"."month" < ? AND "fct_subscription_monthly"."status" = ? GROUP BY "dim_monthly"."product_family", CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) ORDER BY "dim_monthly"."product_family", CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE)
