+fn one_or_many<'de, D: serde::Deserializer<'de>>(read: D) -> Result<Option<Vec<RawDelegation>>, D::Error> {
+    #[derive(serde::Deserialize)]
+    #[serde(untagged)]
+    enum OneOrMany {
+        One(RawDelegation),
+        Many(Vec<RawDelegation>),
+    }
+    Ok(Some(match serde::Deserialize::deserialize(read)? {
+        OneOrMany::One(one) => vec![one],
+        OneOrMany::Many(many) => many,
+    }))
+}
+
 /// A `delegation` key written with no value (`delegation:` or `delegation: null`) reads as an empty
