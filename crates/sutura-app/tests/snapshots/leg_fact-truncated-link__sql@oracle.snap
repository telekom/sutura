---
source: crates/sutura-app/tests/golden/legs.rs
expression: query.sql()
---
SELECT CAST(TRUNC("fct_subscription_monthly"."usage_date", 'MM') AS DATE) AS "0_link", CAST(TRUNC("fct_subscription_monthly"."month", 'MM') AS DATE) AS "period", SUM("fct_subscription_monthly"."voice_min") AS "0_leaf_0" FROM "fct_subscription_monthly" WHERE "fct_subscription_monthly"."month" >= :1 AND "fct_subscription_monthly"."month" < :2 AND "fct_subscription_monthly"."status" = :3 GROUP BY CAST(TRUNC("fct_subscription_monthly"."usage_date", 'MM') AS DATE), CAST(TRUNC("fct_subscription_monthly"."month", 'MM') AS DATE) ORDER BY CAST(TRUNC("fct_subscription_monthly"."usage_date", 'MM') AS DATE), CAST(TRUNC("fct_subscription_monthly"."month", 'MM') AS DATE)
