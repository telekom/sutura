---
source: crates/sutura-app/tests/golden/legs.rs
expression: query.sql()
---
SELECT "fct_subscription_monthly"."customer_key" AS "0_link", CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) AS "period", if(toTypeName(sum("fct_subscription_monthly"."mrr_cents")) IN ('Int64', 'Nullable(Int64)', 'UInt64', 'Nullable(UInt64)', 'Int128', 'Nullable(Int128)'), tuple('Int128', toDecimal256(sum(accurateCastOrNull("fct_subscription_monthly"."mrr_cents", 'Int128')), 0), CAST(NULL AS Nullable(Decimal(76, 38))), CAST(NULL AS Nullable(Float64))), tuple(toTypeName(sum("fct_subscription_monthly"."mrr_cents")), CAST(NULL AS Nullable(Decimal(76, 0))), if(toTypeName(sum("fct_subscription_monthly"."mrr_cents")) LIKE '%Decimal(%', toDecimal256(sum("fct_subscription_monthly"."mrr_cents"), 38), NULL), if(toTypeName(sum("fct_subscription_monthly"."mrr_cents")) LIKE '%Float%', toFloat64(sum("fct_subscription_monthly"."mrr_cents")), NULL))) AS "0_leaf_0", COUNT("fct_subscription_monthly"."mrr_cents") AS "0_leaf_1" FROM "fct_subscription_monthly" WHERE "fct_subscription_monthly"."month" >= ? AND "fct_subscription_monthly"."month" < ? AND "fct_subscription_monthly"."status" = ? GROUP BY "fct_subscription_monthly"."customer_key", CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) ORDER BY "fct_subscription_monthly"."customer_key", CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE)
