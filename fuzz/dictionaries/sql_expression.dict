# Tokens for the authored SQL fragment, so libFuzzer learns the aggregation subset this crate
# carries instead of just the SQL alphabet.
sum="SUM("
count="COUNT("
distinct="DISTINCT "
nullif="NULLIF("
case="CASE WHEN "
when="WHEN "
then="THEN "
end="END "
else="ELSE "
paren_open="("
paren_close=")"
plus=" + "
div=" / "
mult=" * "
eq=" = "
col="\x22mrr_eur\x22"
status="\x22status\x22"
table="\x22fact_subscription\x22"
