---
source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT CAST(TRUNC("fct_usage_daily"."usage_date", 'MM') AS DATE) AS "period", SUM("fct_usage_daily"."voice_min") AS "voice_minutes" FROM "fct_usage_daily" WHERE "fct_usage_daily"."usage_date" >= :1 AND "fct_usage_daily"."usage_date" < :2 GROUP BY CAST(TRUNC("fct_usage_daily"."usage_date", 'MM') AS DATE) ORDER BY CAST(TRUNC("fct_usage_daily"."usage_date", 'MM') AS DATE) LIMIT 10001
