# A JWT is three base64url segments. These are the encoded headers the validator branches on,
# plus the separator, so the mutator can build a well-formed token instead of finding one.
"."
"eyJhbGciOiJFUzI1NiIsInR5cCI6ImF0K2p3dCIsImtpZCI6ImZ1enotc2VlZC1rZXkifQ"
"eyJhbGciOiJub25lIn0"
"eyJhbGciOiJIUzI1NiJ9"
"eyJhbGciOiJSUzI1NiJ9"
"fuzz-seed-key"
"at+jwt"
"Bearer "
