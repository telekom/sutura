#!/usr/bin/env sh
# Refuse to commit anything that must not be published from this PUBLIC repository.
#
# The guard's pattern list is deliberately NOT stored here, and neither is its location:
# both would defeat the purpose. Point SUTURA_LEAK_GUARD at it.
#
# FAILS CLOSED. Without a reachable guard the commit is refused, not allowed through.
#   SUTURA_LEAK_GUARD       path to the guard script            (required)
#   SUTURA_LEAK_GUARD_PY    interpreter to use                  (optional)
#   SUTURA_LEAK_GUARD_SKIP=1  deliberate override; justify it in the commit body
set -eu

if [ "${SUTURA_LEAK_GUARD_SKIP:-0}" = "1" ]; then
  echo "pre-commit: leak guard SKIPPED by request" >&2
  exit 0
fi

if [ -z "${SUTURA_LEAK_GUARD:-}" ] || [ ! -f "${SUTURA_LEAK_GUARD}" ]; then
  cat >&2 <<'MSG'
pre-commit: REFUSING COMMIT -- leak guard not configured or not found.

This repository is public. Commits are blocked until the guard is reachable:

  export SUTURA_LEAK_GUARD=/path/to/your/guard.py

Deliberate override (only for a commit you have read in full):

  SUTURA_LEAK_GUARD_SKIP=1 git commit ...
MSG
  exit 1
fi

PY=""
if [ -n "${SUTURA_LEAK_GUARD_PY:-}" ]; then
  PY="$SUTURA_LEAK_GUARD_PY"
else
  for c in python3 python py; do
    if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
  done
fi

if [ -z "$PY" ]; then
  echo "pre-commit: REFUSING COMMIT -- no Python interpreter found; set SUTURA_LEAK_GUARD_PY." >&2
  exit 1
fi

exec "$PY" "$SUTURA_LEAK_GUARD" --staged "$(git rev-parse --show-toplevel)"
