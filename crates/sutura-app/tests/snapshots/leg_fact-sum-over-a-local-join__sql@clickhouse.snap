---
source: crates/sutura-app/tests/golden/legs.rs
expression: query.sql()
---
SELECT "dim_product"."product_family" AS "product_family", "fct_subscription_monthly"."customer_key" AS "0_link", CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) AS "period", sum("fct_subscription_monthly"."mrr_cents") AS "0_leaf_0" FROM "fct_subscription_monthly" LEFT JOIN "dim_product" ON "fct_subscription_monthly"."product_key" = "dim_product"."product_key" WHERE "fct_subscription_monthly"."month" >= ? AND "fct_subscription_monthly"."month" < ? AND "fct_subscription_monthly"."status" = ? GROUP BY "dim_product"."product_family", "fct_subscription_monthly"."customer_key", CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) ORDER BY "dim_product"."product_family", "fct_subscription_monthly"."customer_key", CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE)
