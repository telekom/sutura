+type googleRequestObservation struct {
+	host, path, authorization, body string
+	clientCertificates              int
+}
+
+type googleEndpointRecorder struct {
+	hosts    []string
+	requests []googleRequestObservation
+}
+
+func (r *googleEndpointRecorder) RoundTrip(request *http.Request) (*http.Response, error) {
+	r.hosts = append(r.hosts, request.URL.Hostname())
+	var payload []byte
+	if request.Body != nil {
+		payload, _ = io.ReadAll(request.Body)
+	}
+	r.requests = append(r.requests, googleRequestObservation{host: request.URL.Hostname(), path: request.URL.Path, authorization: request.Header.Get("Authorization"), body: string(payload)})
+	body := ""
+	switch request.URL.Hostname() {
+	case "iamcredentials-example.p.googleapis.com":
+		body = `{"signedJwt":"signed-assertion"}`
+	case "oauth2-example.p.googleapis.com":
+		body = `{"access_token":"delegated-token","token_type":"Bearer","expires_in":3600}`
+	case "sts-example.p.googleapis.com":
+		body = `{"access_token":"deployment-token","token_type":"Bearer","expires_in":3600,"issued_token_type":"urn:ietf:params:oauth:token-type:access_token"}`
+	case "bigquery-example.p.googleapis.com":
+		body = `{"jobComplete":true,"jobReference":{"projectId":"test-project","jobId":"endpoint-job","location":"US"},"schema":{"fields":[{"name":"n","type":"INTEGER"}]},"totalRows":"1","rows":[{"f":[{"v":"1"}]}]}`
+	}
+	return &http.Response{StatusCode: http.StatusOK, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(strings.NewReader(body)), Request: request}, nil
+}
