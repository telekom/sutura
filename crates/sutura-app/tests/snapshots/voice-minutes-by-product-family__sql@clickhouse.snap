---
source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT "dim_product"."product_family" AS "product_family", CAST(dateTrunc('month', "fct_usage_daily"."usage_date") AS DATE) AS "period", if(toTypeName(sum("fct_usage_daily"."voice_min")) IN ('Int64', 'UInt64', 'Nullable(Int64)', 'Nullable(UInt64)'), tuple('Int128', CAST(sum(accurateCastOrNull("fct_usage_daily"."voice_min", 'Int128')) AS Dynamic)), tuple(toTypeName(sum("fct_usage_daily"."voice_min")), CAST(sum("fct_usage_daily"."voice_min") AS Dynamic))) AS "voice_minutes" FROM "fct_usage_daily" LEFT JOIN "fct_subscription_monthly" ON "fct_usage_daily"."subscription_key" = "fct_subscription_monthly"."subscription_key" AND CAST(dateTrunc('month', "fct_usage_daily"."usage_date") AS DATE) = "fct_subscription_monthly"."month" LEFT JOIN "dim_product" ON "fct_subscription_monthly"."product_key" = "dim_product"."product_key" WHERE "fct_usage_daily"."usage_date" >= ? AND "fct_usage_daily"."usage_date" < ? GROUP BY "dim_product"."product_family", CAST(dateTrunc('month', "fct_usage_daily"."usage_date") AS DATE) ORDER BY "dim_product"."product_family", CAST(dateTrunc('month', "fct_usage_daily"."usage_date") AS DATE) LIMIT 10001
