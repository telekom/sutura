---
source: crates/sutura-cli/tests/example.rs
expression: rendered(&query)
---
SELECT "dim_customer"."region" AS "region", "fct_subscription_monthly"."contract_term" AS "contract_term", CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) AS "period", COUNT("fct_subscription_monthly"."subscription_key") AS "subscription_months_billed" FROM "fct_subscription_monthly" LEFT JOIN "dim_customer" ON "fct_subscription_monthly"."customer_key" = "dim_customer"."customer_key" WHERE "fct_subscription_monthly"."month" >= ? AND "fct_subscription_monthly"."month" < ? GROUP BY "dim_customer"."region", "fct_subscription_monthly"."contract_term", CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) ORDER BY "dim_customer"."region", "fct_subscription_monthly"."contract_term", CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) LIMIT 10001
-- $1 = 2026-01-01
-- $2 = 2026-07-01
