---
source: crates/sutura-app/tests/golden/legs.rs
expression: query.sql()
---
SELECT CAST(DATE_TRUNC('month', "fct_subscription_monthly"."usage_date") AS DATE) AS "0_link", CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) AS "period", SUM("fct_subscription_monthly"."voice_min") AS "0_leaf_0" FROM "fct_subscription_monthly" WHERE "fct_subscription_monthly"."month" >= ? AND "fct_subscription_monthly"."month" < ? AND "fct_subscription_monthly"."status" = ? GROUP BY CAST(DATE_TRUNC('month', "fct_subscription_monthly"."usage_date") AS DATE), CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) ORDER BY CAST(DATE_TRUNC('month', "fct_subscription_monthly"."usage_date") AS DATE) NULLS LAST, CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) NULLS LAST
