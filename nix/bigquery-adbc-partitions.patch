+func TestPartitionDescriptorRoundTrip(t *testing.T) {
+	streamName := "projects/p/locations/us/sessions/s1/streams/stream-0"
+	descriptor := encodePartitionDescriptor(streamName)
+
+	got, err := decodePartitionDescriptor(descriptor)
+	if err != nil {
+		t.Fatalf("decodePartitionDescriptor: unexpected error: %v", err)
+	}
+	if got != streamName {
+		t.Fatalf("decodePartitionDescriptor: got %q, want %q", got, streamName)
+	}
+
+	// The descriptor carries only the stream name: nothing else should have
+	// been smuggled in alongside it.
+	if len(descriptor) != 1+len(streamName) {
+		t.Fatalf("descriptor length = %d, want %d", len(descriptor), 1+len(streamName))
+	}
+}
