+// A stream whose Arrow schema does not decode leaves ReadPartition with an
+// error and no reader to release, so nothing but ReadPartition itself can
+// close the gRPC stream it opened.
+func TestPartitionReadClosesStreamWhenDecodingFails(t *testing.T) {
+	client, fake := clientOfFakeStorageRead(t)
+	closed := make(chan struct{})
+	fake.read = func(stream storagepb.BigQueryRead_ReadRowsServer) error {
+		// A message length of 2 where the schema message belongs: it cannot be decoded.
+		undecodable := []byte{2, 0, 0, 0}
+		if err := stream.Send(&storagepb.ReadRowsResponse{
+			Schema: &storagepb.ReadRowsResponse_ArrowSchema{
+				ArrowSchema: &storagepb.ArrowSchema{SerializedSchema: undecodable},
+			},
+			// The response still carries the Arrow rows union the iterator consumes.
+			Rows: &storagepb.ReadRowsResponse_ArrowRecordBatch{
+				ArrowRecordBatch: &storagepb.ArrowRecordBatch{},
+			},
+		}); err != nil {
+			return err
+		}
+		<-stream.Context().Done()
+		close(closed)
+		return stream.Context().Err()
+	}
+
+	streamName := "projects/p/locations/us/sessions/s1/streams/stream-0"
+	if _, err := readPartitionRecordReader(context.Background(), client, streamName, memory.DefaultAllocator, 1); err == nil {
+		t.Fatal("readPartitionRecordReader: the stream's schema cannot be decoded, got no error")
+	}
+	recorded(t, fake.reads)
+
+	select {
+	case <-closed:
+	case <-time.After(10 * time.Second):
+		t.Fatal("the read stream stayed open after its schema failed to decode")
+	}
+}
