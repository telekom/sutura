{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "This tool returns the catalog of what this deployment measures, narrowed to what the calling\nprincipal may see - the metrics, grains, dimensions and permitted values.\n\n`model` is optional and narrows the answer to one named model: only the metrics tied to it, and -\nwhere the operator exposes physical schema - only that model's own columns and relationships.\nOmit it for the whole catalog. An unfiltered catalog whose physical schema would be large is\nitself capped at a byte bound; where it is, the models left out are named explicitly, and this\nfield is how to read each of them in turn - call this tool again with `model` set to one of those\nnames.\n\nThis tool also returns the catalog's own knowledge (the glossary, caveats, worked examples and\nterms recorded as undefined it carries) and the deployment operator's instructions - neither is\nscoped to one model, so `model` does not narrow them.",
  "properties": {
    "model": {
      "description": "The model's own name - the same identifier its physical schema prints as `model <name>`.\nOmit it for the whole catalog.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "title": "DescribeCatalogArgs",
  "type": "object"
}
