---
source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT CAST(dateTrunc('day', "fct_usage_daily"."usage_date") AS DATE) AS "period", if(toTypeName(sum("fct_usage_daily"."voice_min")) IN ('Int64', 'Nullable(Int64)', 'UInt64', 'Nullable(UInt64)', 'Int128', 'Nullable(Int128)'), tuple('Int128', toDecimal256(sum(accurateCastOrNull("fct_usage_daily"."voice_min", 'Int128')), 0), CAST(NULL AS Nullable(Decimal(76, 38))), CAST(NULL AS Nullable(Float64))), tuple(toTypeName(sum("fct_usage_daily"."voice_min")), CAST(NULL AS Nullable(Decimal(76, 0))), if(toTypeName(sum("fct_usage_daily"."voice_min")) LIKE '%Decimal(%', toDecimal256(sum("fct_usage_daily"."voice_min"), 38), NULL), if(toTypeName(sum("fct_usage_daily"."voice_min")) LIKE '%Float%', toFloat64(sum("fct_usage_daily"."voice_min")), NULL))) AS "voice_minutes" FROM "fct_usage_daily" WHERE "fct_usage_daily"."usage_date" >= ? AND "fct_usage_daily"."usage_date" < ? GROUP BY CAST(dateTrunc('day', "fct_usage_daily"."usage_date") AS DATE) ORDER BY CAST(dateTrunc('day', "fct_usage_daily"."usage_date") AS DATE) LIMIT 10001
