# The test-infra's own task entry point. `just` walks up to this file from
# `test-infra/`, so EVERYTHING here runs against the repository root's environment -
# there is no parallel tooling.

# Authenticate against Google Cloud for the Pulumi provider. Maps to pixi's own `gl`
# task, which runs BOTH logins in one container into ~/.config/gcloud:
#   * `gcloud auth login` - the CLI's OWN credentials (credentials.db);
#   * `gcloud auth application-default login` - **ADC**, what client libraries
#     (Pulumi's gcp provider, Google client libs) read from
#     ~/.config/gcloud/application_default_credentials.json.
# `< -e gcloud` is required because pixi declares `gl` in the `gcloud` FEATURE's tasks,
# not in the default environment - a bare `pixi run gl` does not resolve it. Same
# invocation as the root `just gcloud-login`; interactive (`-it`), not in any gate, and
# nothing is written into this repository.
gl:
    pixi run --frozen -e gcloud gl

# Apply and preview against the Pulumi stack in `pulumi/google`. Both run through the
# `infra` pixi env (Python + pulumi + pulumi-gcp), so there is no venv and no
# requirements.txt to keep in step - pixi owns the interpreter and everything in it, the
# same reasoning the docs env uses. `cd` into the project so pulumi finds Pulumi.yaml;
# extra flags (e.g. `--stack dev`) flow through as appended arguments.
preview *flags:
    cd '{{ justfile_directory() }}/pulumi/google' && pixi run -e infra preview {{flags}}
up *flags:
    cd '{{ justfile_directory() }}/pulumi/google' && pixi run -e infra up {{flags}}
