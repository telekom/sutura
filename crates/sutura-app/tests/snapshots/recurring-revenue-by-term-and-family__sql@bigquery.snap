SELECT `fct_subscription_monthly`.`contract_term` AS `contract_term`, `dim_product`.`product_family` AS `product_family`, CAST(DATE_TRUNC(`fct_subscription_monthly`.`month`, MONTH) AS DATE) AS `period`, sum(`fct_subscription_monthly`.`mrr_cents`) AS `recurring_revenue` FROM `fct_subscription_monthly` LEFT JOIN `dim_product` ON `fct_subscription_monthly`.`product_key` = `dim_product`.`product_key` WHERE `fct_subscription_monthly`.`month` >= ? AND `fct_subscription_monthly`.`month` < ? AND `fct_subscription_monthly`.`status` = ? GROUP BY `fct_subscription_monthly`.`contract_term`, `dim_product`.`product_family`, CAST(DATE_TRUNC(`fct_subscription_monthly`.`month`, MONTH) AS DATE) ORDER BY `fct_subscription_monthly`.`contract_term`, `dim_product`.`product_family`, CAST(DATE_TRUNC(`fct_subscription_monthly`.`month`, MONTH) AS DATE) LIMIT 10001
