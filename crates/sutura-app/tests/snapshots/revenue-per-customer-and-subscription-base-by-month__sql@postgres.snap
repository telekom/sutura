---
source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) AS "period", CAST(SUM(CASE WHEN "fct_subscription_monthly"."status" = $1 THEN "fct_subscription_monthly"."mrr_cents" END) AS DOUBLE PRECISION) / NULLIF(COUNT(DISTINCT CASE WHEN "fct_subscription_monthly"."status" = $1 THEN "fct_subscription_monthly"."customer_key" END), 0) AS "revenue_per_customer", COUNT(DISTINCT "fct_subscription_monthly"."subscription_key") AS "subscription_base" FROM "fct_subscription_monthly" WHERE "fct_subscription_monthly"."month" >= $2 AND "fct_subscription_monthly"."month" < $3 GROUP BY CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) ORDER BY CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) LIMIT 10001
