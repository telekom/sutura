---
source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) AS "period", sum("fct_subscription_monthly"."mrr_cents") AS "recurring_revenue" FROM "fct_subscription_monthly" WHERE "fct_subscription_monthly"."month" >= ? AND "fct_subscription_monthly"."month" < ? AND "fct_subscription_monthly"."status" = ? GROUP BY CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) ORDER BY CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) LIMIT 10001
