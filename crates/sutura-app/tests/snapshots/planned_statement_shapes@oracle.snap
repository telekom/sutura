---
source: crates/sutura-app/tests/golden/statements.rs
expression: corpus
---
plain_filter
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)

aliased_filter
SELECT CAST("k"."subscription_key" AS INTEGER) AS "key" FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)) "k"

not_null_and_filter
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."usage_date" IS NOT NULL AND ("fct_usage_daily"."subscription_key" = 1002))

count_column_filter
SELECT count("subscription_key") AS "n" FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."voice_min" = 0.0)) "fct_usage_daily"

ordered_filter_limit
SELECT "key" FROM (SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key", "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002) ORDER BY "fct_usage_daily"."subscription_key" ASC NULLS LAST FETCH FIRST 2 ROWS ONLY)

grouped_count_star
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key", count(1) AS "n" FROM "fct_usage_daily" GROUP BY "fct_usage_daily"."subscription_key"

date_comparison
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."usage_date" >= TIMESTAMP '2026-06-02 00:00:00')

timestamp_comparison
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."usage_date" >= TIMESTAMP '2026-06-02 00:00:00')

date_between
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" WHERE (("fct_usage_daily"."usage_date" >= TIMESTAMP '2026-06-01 00:00:00') AND ("fct_usage_daily"."usage_date" <= TIMESTAMP '2026-06-02 00:00:00'))

date_part_year
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" WHERE (("fct_usage_daily"."usage_date" >= TIMESTAMP '2026-01-01 00:00:00') AND ("fct_usage_daily"."usage_date" < TIMESTAMP '2027-01-01 00:00:00'))

extract_year
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" WHERE (("fct_usage_daily"."usage_date" >= TIMESTAMP '2026-01-01 00:00:00') AND ("fct_usage_daily"."usage_date" < TIMESTAMP '2027-01-01 00:00:00'))

count_star_filter
SELECT count(1) AS "n" FROM (SELECT 1 FROM "fct_usage_daily" WHERE ("fct_usage_daily"."voice_min" = 0.0))

count_one_filter
SELECT count(1) AS "n" FROM (SELECT 1 FROM "fct_usage_daily" WHERE ("fct_usage_daily"."voice_min" = 0.0))

filter_limit
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002) FETCH FIRST 2 ROWS ONLY

filter_wide_limit
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key", CAST("fct_usage_daily"."voice_min" AS INTEGER) AS "voice" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002) FETCH FIRST 2 ROWS ONLY

count_star
SELECT count(1) AS "n" FROM "fct_usage_daily"

aliased_filter_limit
SELECT CAST("k"."subscription_key" AS INTEGER) AS "key" FROM (SELECT * FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)) "k" OFFSET 0 ROWS FETCH FIRST 2 ROWS ONLY) "k"

aliased_filter_wide_limit
SELECT CAST("k"."subscription_key" AS INTEGER) AS "key", CAST("k"."voice_min" AS INTEGER) AS "voice" FROM (SELECT * FROM (SELECT "fct_usage_daily"."subscription_key", "fct_usage_daily"."voice_min" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)) "k" OFFSET 0 ROWS FETCH FIRST 2 ROWS ONLY) "k"

aliased_ordered_filter_limit
SELECT "key" FROM (SELECT CAST("k"."subscription_key" AS INTEGER) AS "key", "k"."subscription_key" FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)) "k" ORDER BY "k"."subscription_key" ASC NULLS LAST FETCH FIRST 2 ROWS ONLY)

correlated_exists
SELECT CAST("k"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" "k" WHERE EXISTS (SELECT 1 FROM (SELECT "x"."subscription_key" FROM "fct_usage_daily" "x") "__correlated_sq_1" WHERE ("k"."subscription_key" = "__correlated_sq_1"."subscription_key"))

correlated_exists_filter
SELECT CAST("k"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" "k" WHERE EXISTS (SELECT 1 FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)) "__correlated_sq_1" WHERE ("k"."subscription_key" = "__correlated_sq_1"."subscription_key"))

self_in_filter
SELECT CAST("k"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" "k" WHERE EXISTS (SELECT 1 FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)) "__correlated_sq_1" WHERE ("k"."subscription_key" = "__correlated_sq_1"."subscription_key"))

self_in_filter_wide_limit
SELECT CAST("k"."subscription_key" AS INTEGER) AS "key", CAST("k"."voice_min" AS INTEGER) AS "voice" FROM (SELECT "k"."subscription_key", "k"."voice_min" FROM "fct_usage_daily" "k" WHERE EXISTS (SELECT 1 FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)) "__correlated_sq_1" WHERE ("k"."subscription_key" = "__correlated_sq_1"."subscription_key")) OFFSET 0 ROWS FETCH FIRST 2 ROWS ONLY) "k"

correlated_not_exists_preserves_outer_filter
SELECT CAST("k"."subscription_key" AS INTEGER) AS "key" FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)) "k" WHERE NOT EXISTS (SELECT 1 FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE (("fct_usage_daily"."voice_min" < 0.0) AND ("fct_usage_daily"."subscription_key" = 1002))) "__correlated_sq_1" WHERE ("k"."subscription_key" = "__correlated_sq_1"."subscription_key"))
