---
source: crates/sutura-app/tests/golden/legs.rs
expression: query.sql()
---
SELECT "fct_subscription_monthly"."customer_key" AS "0_link", CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) AS "period", sum("fct_subscription_monthly"."mrr_cents") AS "0_leaf_0", COUNT("fct_subscription_monthly"."mrr_cents") AS "0_leaf_1" FROM "fct_subscription_monthly" WHERE "fct_subscription_monthly"."month" >= ? AND "fct_subscription_monthly"."month" < ? AND "fct_subscription_monthly"."status" = ? GROUP BY "fct_subscription_monthly"."customer_key", CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) ORDER BY "fct_subscription_monthly"."customer_key", CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE)
