---
source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) AS "period", CAST(if(toTypeName(sum("fct_subscription_monthly"."mrr_cents")) IN ('Int64', 'Nullable(Int64)', 'UInt64', 'Nullable(UInt64)', 'Int128', 'Nullable(Int128)'), toFloat64(sum(accurateCastOrNull("fct_subscription_monthly"."mrr_cents", 'Int128'))), toFloat64(sum("fct_subscription_monthly"."mrr_cents"))) AS Nullable(Float64)) / sum(CASE WHEN "fct_subscription_monthly"."churned_in_month" THEN 1 ELSE 0 END) AS "revenue_per_churned_subscription" FROM "fct_subscription_monthly" WHERE "fct_subscription_monthly"."month" >= ? AND "fct_subscription_monthly"."month" < ? GROUP BY CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) ORDER BY CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) LIMIT 10001
