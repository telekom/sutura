+					io.WriteString(w, `{"jobComplete":true,"jobReference":{"projectId":"test-project","jobId":"refresh-job","location":"US"},"schema":{"fields":[{"name":"n","type":"INTEGER"}]},"totalRows":"1","rows":[{"f":[{"v":"1"}]}]}`)
