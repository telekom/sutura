# JWK set structure, so libFuzzer starts from the format's own tokens instead of discovering
# them a byte at a time. Every entry is a JWK member name or a value the parse branches on.
"\"keys\""
"\"kty\""
"\"kid\""
"\"use\""
"\"alg\""
"\"crv\""
"\"x\""
"\"y\""
"\"n\""
"\"e\""
"\"k\""
"\"d\""
"\"EC\""
"\"RSA\""
"\"oct\""
"\"OKP\""
"\"P-256\""
"\"P-384\""
"\"P-521\""
"\"Ed25519\""
"\"ES256\""
"\"RS256\""
"\"HS256\""
"\"none\""
"\"sig\""
