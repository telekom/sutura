bare_join_left_filter_limit
SELECT "a"."subscription_key" AS "c0", "b"."subscription_key" AS "c1" FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ((("fct_usage_daily"."subscription_key" >= 1001) AND ("fct_usage_daily"."subscription_key" <= 1002)) AND ("fct_usage_daily"."voice_min" = 0.0))) "a" INNER JOIN "fct_subscription_monthly" "b" ON "a"."subscription_key" = "b"."subscription_key" WHERE (("b"."subscription_key" >= 1001) AND ("b"."subscription_key" <= 1002)) FETCH FIRST 200 ROWS ONLY

bare_join_right_filter
SELECT "a"."subscription_key" AS "c0", "b"."subscription_key" AS "c1" FROM "fct_usage_daily" "a" INNER JOIN (SELECT "fct_subscription_monthly"."subscription_key" FROM "fct_subscription_monthly" WHERE ((("fct_subscription_monthly"."month" >= TIMESTAMP '2026-04-01 00:00:00') AND ("fct_subscription_monthly"."subscription_key" >= 1001)) AND ("fct_subscription_monthly"."subscription_key" <= 1002))) "b" ON "a"."subscription_key" = "b"."subscription_key" WHERE (("a"."subscription_key" >= 1001) AND ("a"."subscription_key" <= 1002))

bare_join_explicit_alias
SELECT "a"."subscription_key", "b"."subscription_key" AS "right_key" FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ((("fct_usage_daily"."subscription_key" >= 1001) AND ("fct_usage_daily"."subscription_key" <= 1002)) AND ("fct_usage_daily"."voice_min" = 0.0))) "a" INNER JOIN "fct_subscription_monthly" "b" ON "a"."subscription_key" = "b"."subscription_key" WHERE (("b"."subscription_key" >= 1001) AND ("b"."subscription_key" <= 1002)) FETCH FIRST 200 ROWS ONLY

bare_join_ordered_limit
SELECT "a"."subscription_key" AS "c0", "b"."subscription_key" AS "c1" FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ((("fct_usage_daily"."subscription_key" >= 1001) AND ("fct_usage_daily"."subscription_key" <= 1002)) AND ("fct_usage_daily"."voice_min" = 0.0))) "a" INNER JOIN "fct_subscription_monthly" "b" ON "a"."subscription_key" = "b"."subscription_key" WHERE (("b"."subscription_key" >= 1001) AND ("b"."subscription_key" <= 1002)) ORDER BY "a"."subscription_key" ASC NULLS LAST, "b"."subscription_key" ASC NULLS LAST FETCH FIRST 200 ROWS ONLY

join_left_filter_limit
SELECT CAST("a"."subscription_key" AS INTEGER) AS "left_key", CAST("b"."subscription_key" AS INTEGER) AS "right_key", CAST(EXTRACT(DAY FROM "a"."usage_date") AS INTEGER) AS "usage_day", CAST(EXTRACT(MONTH FROM "b"."month") AS INTEGER) AS "billing_month" FROM (SELECT "fct_usage_daily"."usage_date", "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ((("fct_usage_daily"."subscription_key" >= 1001) AND ("fct_usage_daily"."subscription_key" <= 1002)) AND ("fct_usage_daily"."voice_min" = 0.0))) "a" INNER JOIN "fct_subscription_monthly" "b" ON "a"."subscription_key" = "b"."subscription_key" WHERE (("b"."subscription_key" >= 1001) AND ("b"."subscription_key" <= 1002)) FETCH FIRST 200 ROWS ONLY

join_right_filter_limit
SELECT CAST("a"."subscription_key" AS INTEGER) AS "left_key", CAST("b"."subscription_key" AS INTEGER) AS "right_key", CAST(EXTRACT(DAY FROM "a"."usage_date") AS INTEGER) AS "usage_day", CAST(EXTRACT(MONTH FROM "b"."month") AS INTEGER) AS "billing_month" FROM "fct_usage_daily" "a" INNER JOIN "fct_subscription_monthly" "b" ON "a"."subscription_key" = "b"."subscription_key" WHERE (("a"."subscription_key" >= 1001) AND ("a"."subscription_key" <= 1002)) AND ((("b"."month" >= TIMESTAMP '2026-04-01 00:00:00') AND ("b"."subscription_key" >= 1001)) AND ("b"."subscription_key" <= 1002)) FETCH FIRST 200 ROWS ONLY

join_no_filter_limit
SELECT CAST("a"."subscription_key" AS INTEGER) AS "left_key", CAST("b"."subscription_key" AS INTEGER) AS "right_key", CAST(EXTRACT(DAY FROM "a"."usage_date") AS INTEGER) AS "usage_day", CAST(EXTRACT(MONTH FROM "b"."month") AS INTEGER) AS "billing_month" FROM "fct_usage_daily" "a" INNER JOIN "fct_subscription_monthly" "b" ON "a"."subscription_key" = "b"."subscription_key" WHERE (("a"."subscription_key" >= 1001) AND ("a"."subscription_key" <= 1002)) AND (("b"."subscription_key" >= 1001) AND ("b"."subscription_key" <= 1002)) FETCH FIRST 200 ROWS ONLY

join_unaliased_filter_limit
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "left_key", CAST("fct_subscription_monthly"."subscription_key" AS INTEGER) AS "right_key", CAST(EXTRACT(DAY FROM "fct_usage_daily"."usage_date") AS INTEGER) AS "usage_day", CAST(EXTRACT(MONTH FROM "fct_subscription_monthly"."month") AS INTEGER) AS "billing_month" FROM (SELECT "fct_usage_daily"."usage_date", "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ((("fct_usage_daily"."subscription_key" >= 1001) AND ("fct_usage_daily"."subscription_key" <= 1002)) AND ("fct_usage_daily"."voice_min" = 0.0))) "fct_usage_daily" INNER JOIN "fct_subscription_monthly" ON "fct_usage_daily"."subscription_key" = "fct_subscription_monthly"."subscription_key" WHERE (("fct_subscription_monthly"."subscription_key" >= 1001) AND ("fct_subscription_monthly"."subscription_key" <= 1002)) FETCH FIRST 200 ROWS ONLY

join_ordered_filter_limit
SELECT CAST("a"."subscription_key" AS INTEGER) AS "left_key", CAST("b"."subscription_key" AS INTEGER) AS "right_key", CAST(EXTRACT(DAY FROM "a"."usage_date") AS INTEGER) AS "usage_day", CAST(EXTRACT(MONTH FROM "b"."month") AS INTEGER) AS "billing_month" FROM (SELECT "fct_usage_daily"."usage_date", "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ((("fct_usage_daily"."subscription_key" >= 1001) AND ("fct_usage_daily"."subscription_key" <= 1002)) AND ("fct_usage_daily"."voice_min" = 0.0))) "a" INNER JOIN "fct_subscription_monthly" "b" ON "a"."subscription_key" = "b"."subscription_key" WHERE (("b"."subscription_key" >= 1001) AND ("b"."subscription_key" <= 1002)) ORDER BY "usage_day" DESC NULLS FIRST, "billing_month" ASC NULLS LAST OFFSET 2 ROWS FETCH FIRST 5 ROWS ONLY

join_filter_without_limit
SELECT CAST("a"."subscription_key" AS INTEGER) AS "left_key", CAST("b"."subscription_key" AS INTEGER) AS "right_key", CAST(EXTRACT(DAY FROM "a"."usage_date") AS INTEGER) AS "usage_day", CAST(EXTRACT(MONTH FROM "b"."month") AS INTEGER) AS "billing_month" FROM (SELECT "fct_usage_daily"."usage_date", "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ((("fct_usage_daily"."subscription_key" >= 1001) AND ("fct_usage_daily"."subscription_key" <= 1002)) AND ("fct_usage_daily"."voice_min" = 0.0))) "a" INNER JOIN "fct_subscription_monthly" "b" ON "a"."subscription_key" = "b"."subscription_key" WHERE (("b"."subscription_key" >= 1001) AND ("b"."subscription_key" <= 1002))

join_nested_windows
SELECT "q"."left_key", "q"."right_key", "q"."usage_day", "q"."billing_month" FROM (SELECT CAST("a"."subscription_key" AS INTEGER) AS "left_key", CAST("b"."subscription_key" AS INTEGER) AS "right_key", CAST(EXTRACT(DAY FROM "a"."usage_date") AS INTEGER) AS "usage_day", CAST(EXTRACT(MONTH FROM "b"."month") AS INTEGER) AS "billing_month" FROM (SELECT "fct_usage_daily"."usage_date", "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ((("fct_usage_daily"."subscription_key" >= 1001) AND ("fct_usage_daily"."subscription_key" <= 1002)) AND ("fct_usage_daily"."voice_min" = 0.0))) "a" INNER JOIN "fct_subscription_monthly" "b" ON ("a"."subscription_key" + 1) = "b"."subscription_key" ORDER BY "usage_day" DESC NULLS FIRST, "billing_month" ASC NULLS LAST OFFSET 1 ROWS FETCH FIRST 8 ROWS ONLY) "q" ORDER BY "q"."billing_month" DESC NULLS FIRST, "q"."usage_day" ASC NULLS LAST OFFSET 2 ROWS FETCH FIRST 3 ROWS ONLY

join_limited_input
SELECT CAST("a"."subscription_key" AS INTEGER) AS "left_key", CAST("b"."subscription_key" AS INTEGER) AS "right_key", CAST(EXTRACT(DAY FROM "a"."usage_date") AS INTEGER) AS "usage_day", 0 AS "billing_month" FROM (SELECT "fct_usage_daily"."usage_date", "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."voice_min" = 0.0)) "a" INNER JOIN (SELECT "fct_subscription_monthly"."subscription_key" FROM "fct_subscription_monthly" WHERE ("fct_subscription_monthly"."subscription_key" = 1003) OFFSET 0 ROWS FETCH FIRST 2 ROWS ONLY) "b" ON ("a"."subscription_key" + 1) = "b"."subscription_key" FETCH FIRST 200 ROWS ONLY

