---
source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT CAST(DATE_TRUNC(`fct_usage_daily`.`usage_date`, MONTH) AS DATE) AS `period`, sum(`fct_usage_daily`.`voice_min`) AS `voice_minutes` FROM `fct_usage_daily` WHERE `fct_usage_daily`.`usage_date` >= ? AND `fct_usage_daily`.`usage_date` < ? GROUP BY CAST(DATE_TRUNC(`fct_usage_daily`.`usage_date`, MONTH) AS DATE) ORDER BY CAST(DATE_TRUNC(`fct_usage_daily`.`usage_date`, MONTH) AS DATE) NULLS LAST LIMIT 10001
