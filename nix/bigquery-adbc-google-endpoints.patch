+
+// Kept on each connection, never in process globals: two sources may declare different trust.
+type googleDestinations struct {
+	iam, oauth, sts           string
+	caFile, certFile, keyFile string
+}
+
+func (d googleDestinations) configured() bool {
+	return d.iam != "" || d.oauth != "" || d.sts != "" || d.caFile != "" || d.certFile != "" || d.keyFile != ""
+}
+
+// Credential detection and the network transport are ports so tests exercise the real auth flow
+// without either a credential file or a server impersonating Google.
+var detectGoogleCredentials = authcredentials.DetectDefault
+var googleBaseTransport = func(config *tls.Config) http.RoundTripper {
+	base := http.DefaultTransport.(*http.Transport).Clone()
+	base.TLSClientConfig = config
+	return base
+}
+
+func readTLSFile(path string) ([]byte, error) {
+	file, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+	data, err := io.ReadAll(io.LimitReader(file, (4<<20)+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(data) > 4<<20 {
+		return nil, fmt.Errorf("TLS material exceeds 4 MiB")
+	}
+	return data, nil
+}
+
+func (d googleDestinations) tlsConfig() (*tls.Config, error) {
+	config := &tls.Config{MinVersion: tls.VersionTLS12}
+	if d.caFile != "" {
+		data, err := readTLSFile(d.caFile)
+		if err != nil {
+			return nil, err
+		}
+		certificates, err := googleCertificates(data)
+		if err != nil {
+			return nil, err
+		}
+		config.RootCAs = x509.NewCertPool()
+		for _, certificate := range certificates {
+			config.RootCAs.AddCert(certificate)
+		}
+	}
+	if d.certFile != "" || d.keyFile != "" {
+		cert, err := readTLSFile(d.certFile)
+		if err != nil {
+			return nil, err
+		}
+		key, err := readTLSFile(d.keyFile)
+		if err != nil {
+			return nil, err
+		}
+		if _, err := googleCertificates(cert); err != nil {
+			return nil, err
+		}
+		key = bytes.TrimSpace(key)
+		if !bytes.HasPrefix(key, []byte("-----BEGIN ")) || bytes.Count(key, []byte("-----BEGIN ")) != 1 {
+			return nil, fmt.Errorf("invalid Google TLS private key block")
+		}
+		block, rest := pem.Decode(key)
+		if block == nil || len(bytes.TrimSpace(rest)) != 0 || len(block.Headers) != 0 || (block.Type != "PRIVATE KEY" && block.Type != "RSA PRIVATE KEY" && block.Type != "EC PRIVATE KEY") {
+			return nil, fmt.Errorf("Google TLS key must contain exactly one plaintext private key")
+		}
+		pair, err := tls.X509KeyPair(cert, key)
+		if err != nil {
+			return nil, err
+		}
+		config.Certificates = []tls.Certificate{pair}
+	}
+	return config, nil
+}
+
+// Refuse the entire bundle when any block is malformed, rather than accepting a valid prefix.
+func googleCertificates(data []byte) ([]*x509.Certificate, error) {
+	var certificates []*x509.Certificate
+	for len(bytes.TrimSpace(data)) != 0 {
+		data = bytes.TrimSpace(data)
+		if !bytes.HasPrefix(data, []byte("-----BEGIN CERTIFICATE-----")) {
+			return nil, fmt.Errorf("invalid Google TLS certificate bundle")
+		}
+		endMarker := []byte("-----END CERTIFICATE-----")
+		end := bytes.Index(data, endMarker)
+		if end < 0 {
+			return nil, fmt.Errorf("incomplete Google TLS certificate block")
+		}
+		blockData := data[:end+len(endMarker)]
+		if bytes.Count(blockData, []byte("-----BEGIN")) != 1 {
+			return nil, fmt.Errorf("invalid Google TLS certificate block")
+		}
+		block, remaining := pem.Decode(blockData)
+		rest := data[end+len(endMarker):]
+		if len(bytes.TrimSpace(remaining)) != 0 || block == nil || block.Type != "CERTIFICATE" || len(block.Headers) != 0 {
+			return nil, fmt.Errorf("invalid Google TLS certificate block")
+		}
+		certificate, err := x509.ParseCertificate(block.Bytes)
+		if err != nil {
+			return nil, fmt.Errorf("invalid Google TLS certificate: %w", err)
+		}
+		certificates = append(certificates, certificate)
+		data = rest
+	}
+	if len(certificates) == 0 {
+		return nil, fmt.Errorf("Google TLS certificate bundle is empty")
+	}
+	return certificates, nil
+}
+
+func googleHTTPClient(transport http.RoundTripper) *http.Client {
+	return &http.Client{Transport: transport, CheckRedirect: func(*http.Request, []*http.Request) error {
+		return fmt.Errorf("Google API redirects are refused")
+	}}
+}
+
+type googleRoutingTransport struct {
+	base         http.RoundTripper
+	destinations googleDestinations
+}
+
+func (t googleRoutingTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	target := ""
+	keepPath := false
+	switch request.URL.Hostname() {
+	case "iamcredentials.googleapis.com", "iamcredentials.mtls.googleapis.com":
+		target, keepPath = t.destinations.iam, true
+	case "oauth2.googleapis.com", "oauth2.mtls.googleapis.com", "accounts.google.com":
+		if request.URL.Path == "/token" || request.URL.Path == "/o/oauth2/token" {
+			target = t.destinations.oauth
+		}
+	case "sts.googleapis.com", "sts.mtls.googleapis.com":
+		target = t.destinations.sts
+	}
+	if target == "" {
+		return t.base.RoundTrip(request)
+	}
+	endpoint, err := url.Parse(target)
+	if err != nil || endpoint.Scheme != "https" || !strings.HasSuffix(endpoint.Hostname(), ".googleapis.com") || endpoint.User != nil || endpoint.RawQuery != "" || endpoint.Fragment != "" {
+		return nil, fmt.Errorf("invalid Google API destination")
+	}
+	routed := request.Clone(request.Context())
+	copyURL := *request.URL
+	routed.URL = &copyURL
+	routed.URL.Scheme, routed.URL.Host = endpoint.Scheme, endpoint.Host
+	if !keepPath {
+		routed.URL.Path, routed.URL.RawPath = endpoint.Path, endpoint.RawPath
+	}
+	routed.Host = ""
+	return t.base.RoundTrip(routed)
+}
+
+// ADC refreshes use the same routing and verified TLS as signJwt and the JWT token exchange.
+func (c *connectionImpl) googleTransport(config *tls.Config) http.RoundTripper {
+	return googleRoutingTransport{base: googleBaseTransport(config), destinations: c.google}
+}
+
+func googleAuthenticatedClient(ctx context.Context, base http.RoundTripper, options []option.ClientOption) (*http.Client, error) {
+	transport, err := htransport.NewTransport(ctx, base, options...)
+	if err != nil {
+		return nil, err
+	}
+	return googleHTTPClient(transport), nil
+}
+
+func googleStorageCredentials(endpoint string, config *tls.Config) credentials.TransportCredentials {
+	// Preserve upstream's explicit numeric-loopback emulator venue only. A custom Google host
+	// always uses hostname verification and the selected roots, including the Storage Read API.
+	host, _, err := net.SplitHostPort(endpoint)
+	if err == nil {
+		if ip := net.ParseIP(host); ip != nil && ip.IsLoopback() {
+			return insecure.NewCredentials()
+		}
+	}
+	return credentials.NewTLS(config.Clone())
+}
