source: crates/sutura-app/tests/golden/legs.rs
expression: query.sql()
---
SELECT `fct_subscription_monthly`.`customer_key` AS `customer_key`, `fct_subscription_monthly`.`subscription_key` AS `subscription_key`, CAST(DATE_TRUNC(`fct_subscription_monthly`.`month`, MONTH) AS DATE) AS `period` FROM `fct_subscription_monthly` WHERE `fct_subscription_monthly`.`month` >= ? AND `fct_subscription_monthly`.`month` < ? AND `fct_subscription_monthly`.`status` = ? GROUP BY `fct_subscription_monthly`.`customer_key`, `fct_subscription_monthly`.`subscription_key`, CAST(DATE_TRUNC(`fct_subscription_monthly`.`month`, MONTH) AS DATE) ORDER BY `fct_subscription_monthly`.`customer_key` NULLS LAST, `fct_subscription_monthly`.`subscription_key` NULLS LAST, CAST(DATE_TRUNC(`fct_subscription_monthly`.`month`, MONTH) AS DATE) NULLS LAST
