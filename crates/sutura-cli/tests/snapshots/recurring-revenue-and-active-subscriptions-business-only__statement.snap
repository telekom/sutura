---
source: crates/sutura-cli/tests/example.rs
expression: rendered(&query)
---
SELECT CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) AS "period", SUM(CASE WHEN "fct_subscription_monthly"."status" = ? THEN "fct_subscription_monthly"."mrr_cents" END) AS "recurring_revenue", COUNT(DISTINCT CASE WHEN "fct_subscription_monthly"."status" = ? THEN "fct_subscription_monthly"."subscription_key" END) AS "active_subscriptions" FROM "fct_subscription_monthly" LEFT JOIN "dim_customer" ON "fct_subscription_monthly"."customer_key" = "dim_customer"."customer_key" WHERE "fct_subscription_monthly"."month" >= ? AND "fct_subscription_monthly"."month" < ? AND "dim_customer"."segment" = ? GROUP BY CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) ORDER BY CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) NULLS LAST LIMIT 10001
-- $1 = "active"
-- $2 = "active"
-- $3 = 2026-06-01
-- $4 = 2026-07-01
-- $5 = "business"
