# Copy to `.env` (gitignored). Every value is optional: unset means "use the public
# default", which is what public CI does. Locally, point these at your mirror so builds do
# not egress directly.

# --- where things are fetched from ------------------------------------------
# Container base image, via a registry mirror.
# BASE_IMAGE=<registry-mirror>/nixos/nix:2.35.2

# Egress proxy. Also what lets Nix fetch flake inputs (github:...) on a network with no
# direct route.
# HTTP_PROXY_URL=http://<proxy-host>:<port>
# NO_PROXY_LIST=localhost,127.0.0.1,::1,<your-internal-domains>

# Nix binary cache. Set this to a mirror so paths are not pulled from the public cache.
#
# NOTE THE URL SHAPE. Use the repository's plain path, NOT the `/api/nix/` one. Both serve
# `nix-cache-info` and `.narinfo` with a 200, so `nix store info` and `nix build --dry-run`
# both report success either way - but the `/api/nix/` variant returns a `.narinfo` whose
# `URL:` field carries a `?narInfoHash=` query parameter, and fetching THAT 404s. Nix then
# silently compiles from source instead of failing, so the symptom is a build that appears to
# work and takes hours, with a bootstrap chain (stage0-posix, sed, tar) in the log.
#
# Verify a mirror end to end before trusting it - a NAR fetch, not just `nix-cache-info`:
#   curl -s "$NIX_SUBSTITUTER/<hash>.narinfo" | grep ^URL:
#   curl -o /dev/null -w '%{http_code}
' "$NIX_SUBSTITUTER/<the URL: field>"
#
# The key stays the UPSTREAM one: a mirror proxies upstream-signed paths, so it does not
# re-sign them and its own identity is not what Nix verifies.
# NIX_SUBSTITUTER=https://<artifact-repo>/<nix-remote>
# NIX_TRUSTED_KEY=cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY=

# Sparse crates index, via a mirror. The TRAILING SLASH is required: cargo refuses a
# sparse URL without one - "sparse registry url must end in a slash" - and the error
# arrives on the first build rather than at configuration time.
# CARGO_REGISTRY_URL=https://<artifact-repo>/api/cargo/<crates-remote>/index/

# --- credentials -----------------------------------------------------------
# Used by gh-axi and anything else talking to the GitHub API. The dev shell reads it from
# here if it is not already in the environment, and only ever reports presence, never the
# value.
# GITHUB_TOKEN=
