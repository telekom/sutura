+package bigquery
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/apache/arrow-adbc/go/adbc"
+	"github.com/apache/arrow-go/v18/arrow"
+	"github.com/apache/arrow-go/v18/arrow/array"
+	"github.com/apache/arrow-go/v18/arrow/memory"
+)
+
+// One request a fake BigQuery endpoint received.
+type seenRequest struct {
+	method, path string
+	body         map[string]any
+	auth         string
+}
+
+// queryThrough runs sql on a fake endpoint that answers every call with answer and returns what
+// reached it. through sets OptionQueryThroughJobsQuery; configure sets statement options.
+func queryThrough(t *testing.T, through string, answer func(w http.ResponseWriter, r *http.Request), configure func(adbc.StatementWithContext)) ([]seenRequest, int64, *arrow.Schema, error) {
+	t.Helper()
+	ctx := context.Background()
+	var mu sync.Mutex
+	var seen []seenRequest
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		// The storage client's gRPC preface also lands here; only a REST call counts.
+		if strings.HasPrefix(r.URL.Path, "/bigquery/v2/") {
+			raw, _ := io.ReadAll(r.Body)
+			var body map[string]any
+			_ = json.Unmarshal(raw, &body)
+			mu.Lock()
+			seen = append(seen, seenRequest{r.Method, strings.TrimPrefix(r.URL.Path, "/bigquery/v2/projects/test-project"), body, r.Header.Get("Authorization")})
+			mu.Unlock()
+		}
+		answer(w, r)
+	}))
+	defer srv.Close()
+
+	db, err := NewDriver(memory.DefaultAllocator).NewDatabaseWithContext(ctx, map[string]string{
+		"bigquery.project_id":        "test-project",
+		"bigquery.endpoint":          srv.URL + "/bigquery/v2/",
+		"bigquery.storage_endpoint":  srv.Listener.Addr().String(),
+		"bigquery.auth_type":         "access_token",
+		"bigquery.auth.access_token": "caller-token",
+		OptionQueryThroughJobsQuery:  through,
+	})
+	if err != nil {
+		t.Fatalf("database: %v", err)
+	}
+	cnxn, err := db.Open(ctx)
+	if err != nil {
+		t.Fatalf("open: %v", err)
+	}
+	defer cnxn.Close(ctx)
+	stmt, err := cnxn.NewStatement(ctx)
+	if err != nil {
+		t.Fatalf("statement: %v", err)
+	}
+	defer stmt.Close(ctx)
+	if err := stmt.SetSqlQuery(ctx, "SELECT ?"); err != nil {
+		t.Fatalf("query: %v", err)
+	}
+	configure(stmt)
+	rdr, rows, err := stmt.ExecuteQuery(ctx)
+	var schema *arrow.Schema
+	if err == nil {
+		schema = rdr.Schema()
+		rdr.Release()
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	return slices.Clone(seen), rows, schema, err
+}
+
+func notFound(w http.ResponseWriter, _ *http.Request) {
+	http.Error(w, `{"error":{"code":404,"message":"none"}}`, http.StatusNotFound)
+}
+
+func boundInt(t *testing.T, stmt adbc.StatementWithContext, v int64) {
+	t.Helper()
+	b := array.NewInt64Builder(memory.DefaultAllocator)
+	defer b.Release()
+	b.Append(v)
+	col := b.NewArray()
+	defer col.Release()
+	batch := array.NewRecordBatch(arrow.NewSchema([]arrow.Field{{Name: "p", Type: arrow.PrimitiveTypes.Int64}}, nil), []arrow.Array{col}, 1)
+	defer batch.Release()
+	if err := stmt.Bind(context.Background(), batch); err != nil {
+		t.Fatalf("bind: %v", err)
+	}
+}
+
+func setInt(t *testing.T, stmt adbc.StatementWithContext, key string, v int64) {
+	t.Helper()
+	if err := stmt.(adbc.GetSetOptionsWithContext).SetOptionInt(context.Background(), key, v); err != nil {
+		t.Fatalf("%s: %v", key, err)
+	}
+}
+
+// A query starts with jobs.query, carrying its parameters, byte ceiling and job timeout, then
+// follows the job jobs.query created, and never reaches jobs.insert.
+func TestThroughJobsQuery(t *testing.T) {
+	ref := `"jobReference":{"projectId":"test-project","jobId":"j1","location":"EU"}`
+	answer := func(w http.ResponseWriter, r *http.Request) {
+		switch {
+		case r.Method == http.MethodPost && strings.HasSuffix(r.URL.Path, "/queries"):
+			_, _ = io.WriteString(w, `{`+ref+`}`)
+		case strings.HasSuffix(r.URL.Path, "/jobs/j1"):
+			_, _ = io.WriteString(w, `{`+ref+`,"configuration":{"query":{"query":"SELECT ?"}},"status":{"state":"DONE"},"statistics":{"query":{"statementType":"INSERT"}}}`)
+		case strings.HasSuffix(r.URL.Path, "/queries/j1"):
+			_, _ = io.WriteString(w, `{`+ref+`,"jobComplete":true,"schema":{"fields":[]},"totalRows":"0"}`)
+		default:
+			notFound(w, r)
+		}
+	}
+	got, _, _, err := queryThrough(t, "true", answer, func(stmt adbc.StatementWithContext) {
+		boundInt(t, stmt, 7)
+		setInt(t, stmt, OptionQueryMaxBytesBilled, 1000)
+		setInt(t, stmt, OptionQueryJobTimeout, 5000)
+	})
+	if err != nil {
+		t.Fatalf("execute: %v", err)
+	}
+	var calls []string
+	for _, r := range got {
+		calls = append(calls, r.method+" "+r.path)
+	}
+	// The driver completes a DML-shaped result from job status without fetching result rows.
+	if want := []string{"POST /queries", "GET /jobs/j1"}; !slices.Equal(calls, want) {
+		t.Fatalf("requests %v, want exactly %v and no jobs.insert", calls, want)
+	}
+	if got[0].auth != "Bearer caller-token" {
+		t.Errorf("jobs.query authorized as %q, want the connection's own token", got[0].auth)
+	}
+	body := got[0].body
+	params, _ := json.Marshal(body["queryParameters"])
+	for key, want := range map[string]string{"query": `"SELECT ?"`, "maximumBytesBilled": `"1000"`, "jobTimeoutMs": `"5000"`, "useLegacySql": "false"} {
+		if v, _ := json.Marshal(body[key]); string(v) != want {
+			t.Errorf("%s = %s, want %s", key, v, want)
+		}
+	}
+	if !strings.Contains(string(params), `"value":"7"`) {
+		t.Errorf("queryParameters %s, want the bound 7", params)
+	}
+	if body["requestId"] == nil {
+		t.Error("no requestId, so a retried jobs.query could run twice")
+	}
+}
+
+// Unset, the driver keeps jobs.insert.
+func TestWithoutThroughJobsQueryInserts(t *testing.T) {
+	got, _, _, _ := queryThrough(t, "false", notFound, func(adbc.StatementWithContext) {})
+	if len(got) == 0 || got[0].path != "/jobs" {
+		t.Fatalf("requests %+v, want jobs.insert first", got)
+	}
+}
+
+// A dry run is a jobs.query dry run, answered from its response: jobs.query creates no job for one.
+func TestThroughJobsQueryDryRun(t *testing.T) {
+	answer := func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = io.WriteString(w, `{"jobComplete":true,"totalBytesProcessed":"42","schema":{"fields":[{"name":"x","type":"INTEGER"}]}}`)
+	}
+	got, rows, schema, err := queryThrough(t, "true", answer, func(stmt adbc.StatementWithContext) {
+		if err := stmt.SetOption(context.Background(), OptionQueryDryRun, "true"); err != nil {
+			t.Fatalf("dry run: %v", err)
+		}
+	})
+	if err != nil {
+		t.Fatalf("execute: %v", err)
+	}
+	if len(got) != 1 || got[0].path != "/queries" || got[0].body["dryRun"] != true {
+		t.Fatalf("requests %+v, want one jobs.query dry run", got)
+	}
+	if rows != 42 || schema.NumFields() != 1 || schema.Field(0).Name != "x" {
+		t.Fatalf("rows %d, schema %v", rows, schema)
+	}
+}
+
+// A setting jobs.query cannot carry is refused before anything is sent, never dropped.
+func TestThroughJobsQueryRefusesWhatItCannotCarry(t *testing.T) {
+	got, _, _, err := queryThrough(t, "true", notFound, func(stmt adbc.StatementWithContext) {
+		if err := stmt.SetOption(context.Background(), OptionQueryDestinationTable, "test-project.d.t"); err != nil {
+			t.Fatalf("destination: %v", err)
+		}
+	})
+	var adbcErr adbc.Error
+	if !errors.As(err, &adbcErr) || adbcErr.Code != adbc.StatusNotImplemented || !strings.Contains(adbcErr.Msg, "destinationTable") {
+		t.Fatalf("got %v, want NotImplemented naming destinationTable", err)
+	}
+	if len(got) != 0 {
+		t.Fatalf("requests %+v, want none", got)
+	}
+}
+
+func TestThroughJobsQueryWithoutAJobRefused(t *testing.T) {
+	answer := func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = io.WriteString(w, `{"jobComplete":true}`)
+	}
