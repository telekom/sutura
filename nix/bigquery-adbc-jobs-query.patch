+	if err != nil {
+		t.Fatalf("execute: %v", err)
+	}
+	if len(got) == 0 || got[0].path != "/queries" {
+		t.Fatalf("requests %+v, want jobs.query first", got)
+	}
+	labels, _ := json.Marshal(got[0].body["labels"])
+	if want := `{"sutura_actor":"","sutura_client":"agent","sutura_correlation":"c-1"}`; string(labels) != want {
+		t.Fatalf("jobs.query labels %s, want %s", labels, want)
+	}
+}
