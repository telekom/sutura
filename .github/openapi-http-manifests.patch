 # links the gRPC client and HTTP/2; `sutura-http-client` carries the source's `delegation` exchange.
 node = ["dep:sutura-exec-node", "dep:sutura-http-client"]
@@ -236,6 +239,8 @@ sutura-catalog-datahub = { workspace = true, optional = true }
