+type googleRedirectTransport struct {
+	calls  int
+	status int
+}
+
+func (r *googleRedirectTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	r.calls++
+	if r.calls != 1 {
+		return nil, fmt.Errorf("redirect reached undeclared destination")
+	}
+	return &http.Response{StatusCode: r.status, Header: http.Header{"Location": []string{"https://undeclared.example/token"}}, Body: io.NopCloser(strings.NewReader("")), Request: request}, nil
+}
