---
source: crates/sutura-app/tests/golden/statements/text.rs
expression: output
---
SELECT `dim_region`.`sales_area` FROM (SELECT `region`, CASE WHEN replaceRegexpAll(`sales_area`, '(?i)north(_east)?', 'masked') IS NULL THEN NULL WHEN lengthUTF8(replaceRegexpAll(`sales_area`, '(?i)north(_east)?', 'masked')) > 28 THEN substringUTF8(replaceRegexpAll(`sales_area`, '(?i)north(_east)?', 'masked'), 1, 28) || '...[truncated]' ELSE substringUTF8(replaceRegexpAll(`sales_area`, '(?i)north(_east)?', 'masked'), 1, 28) END AS `sales_area` FROM `dim_region`) AS `dim_region` WHERE `dim_region`.`sales_area` LIKE 'n%' ORDER BY `dim_region`.`sales_area` ASC NULLS LAST

SELECT min(`dim_region`.`sales_area`) FROM (SELECT `region`, CASE WHEN replaceRegexpAll(`sales_area`, '(?i)north(_east)?', 'masked') IS NULL THEN NULL WHEN lengthUTF8(replaceRegexpAll(`sales_area`, '(?i)north(_east)?', 'masked')) > 28 THEN substringUTF8(replaceRegexpAll(`sales_area`, '(?i)north(_east)?', 'masked'), 1, 28) || '...[truncated]' ELSE substringUTF8(replaceRegexpAll(`sales_area`, '(?i)north(_east)?', 'masked'), 1, 28) END AS `sales_area` FROM `dim_region`) AS `dim_region`

SELECT `r`.`sales_area` FROM (SELECT `dim_region`.`sales_area` FROM (SELECT `region`, CASE WHEN replaceRegexpAll(`sales_area`, '(?i)north(_east)?', 'masked') IS NULL THEN NULL WHEN lengthUTF8(replaceRegexpAll(`sales_area`, '(?i)north(_east)?', 'masked')) > 28 THEN substringUTF8(replaceRegexpAll(`sales_area`, '(?i)north(_east)?', 'masked'), 1, 28) || '...[truncated]' ELSE substringUTF8(replaceRegexpAll(`sales_area`, '(?i)north(_east)?', 'masked'), 1, 28) END AS `sales_area` FROM `dim_region`) AS `dim_region` WHERE (`dim_region`.`sales_area` = 'masked')) AS `r` ORDER BY `r`.`sales_area` ASC NULLS LAST LIMIT 1
