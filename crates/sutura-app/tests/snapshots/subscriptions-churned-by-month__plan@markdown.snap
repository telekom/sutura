---
source: crates/sutura-app/tests/golden/catalogs.rs
expression: plan
---
source: local
metric: subscriptions_churned
table: fct_subscription_monthly
joins: []
bucket:
  label: period
  grain: month
  column:
    table: fct_subscription_monthly
    column: month
keys: []
measure:
  simple:
    term:
      count_if:
        column:
          table: fct_subscription_monthly
          column: churned_in_month
measure_label: subscriptions_churned
filters:
  - origin: definition
    predicate:
      at_or_after:
        column:
          table: fct_subscription_monthly
          column: month
        param: 0
  - origin: definition
    predicate:
      before:
        column:
          table: fct_subscription_monthly
          column: month
        param: 1
params:
  - Date: 2026-01-01
  - Date: 2026-07-01
range:
  start: 2026-01-01
  end: 2026-07-01
max_rows: 10000
