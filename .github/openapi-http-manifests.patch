 cube = ["dep:sutura-catalog-cube", "sutura-catalog-cube/http", "dep:sutura-exec-cube", "dep:sutura-http-client"]
+# EXPERIMENTAL: the OpenAPI metadata adapter's HTTP reader (issue #1727), for `catalog.kind:
