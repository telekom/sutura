---
source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT CAST(TRUNC("fct_subscription_monthly"."month", 'MM') AS DATE) AS "period", AVG(CASE WHEN "fct_subscription_monthly"."status" = :1 THEN "fct_subscription_monthly"."mrr_cents" END) AS "mean_subscription_mrr", COUNT(DISTINCT "fct_subscription_monthly"."subscription_key") AS "subscription_base" FROM "fct_subscription_monthly" WHERE "fct_subscription_monthly"."month" >= :2 AND "fct_subscription_monthly"."month" < :3 GROUP BY CAST(TRUNC("fct_subscription_monthly"."month", 'MM') AS DATE) ORDER BY CAST(TRUNC("fct_subscription_monthly"."month", 'MM') AS DATE) FETCH FIRST 10001 ROWS ONLY
