---
source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT "dim_product"."product_name" AS "product_name", CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) AS "period", if(toTypeName(sum("fct_subscription_monthly"."mrr_cents")) IN ('Int64', 'UInt64', 'Nullable(Int64)', 'Nullable(UInt64)'), tuple('Int128', CAST(sum(toInt128("fct_subscription_monthly"."mrr_cents")) AS Dynamic)), tuple(toTypeName(sum("fct_subscription_monthly"."mrr_cents")), CAST(sum("fct_subscription_monthly"."mrr_cents") AS Dynamic))) AS "recurring_revenue" FROM "fct_subscription_monthly" LEFT JOIN "dim_product" ON "fct_subscription_monthly"."product_key" = "dim_product"."product_key" WHERE "fct_subscription_monthly"."month" >= ? AND "fct_subscription_monthly"."month" < ? AND "fct_subscription_monthly"."status" = ? GROUP BY "dim_product"."product_name", CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) ORDER BY if(toTypeName(sum("fct_subscription_monthly"."mrr_cents")) IN ('Int64', 'UInt64', 'Nullable(Int64)', 'Nullable(UInt64)'), tuple('Int128', CAST(sum(toInt128("fct_subscription_monthly"."mrr_cents")) AS Dynamic)), tuple(toTypeName(sum("fct_subscription_monthly"."mrr_cents")), CAST(sum("fct_subscription_monthly"."mrr_cents") AS Dynamic))) DESC, "dim_product"."product_name", CAST(dateTrunc('month', "fct_subscription_monthly"."month") AS DATE) LIMIT 3
