+			if err != nil {
+				t.Fatal(err)
+			}
+			template := &x509.Certificate{SerialNumber: big.NewInt(3), DNSNames: []string{"bigquery-example.p.googleapis.com", "oauth2-example.p.googleapis.com", "sts-example.p.googleapis.com"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}
+			serverDER, err := x509.CreateCertificate(rand.Reader, template, certificates[0], &serverKey.PublicKey, caIdentity.PrivateKey)
+			if err != nil {
+				t.Fatal(err)
+			}
+			requests := make(chan googleRequestObservation, 16)
+			server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, request *http.Request) {
+				payload, _ := io.ReadAll(request.Body)
+				requests <- googleRequestObservation{host: request.Host, path: request.URL.Path, authorization: request.Header.Get("Authorization"), body: string(payload), clientCertificates: len(request.TLS.PeerCertificates)}
+				w.Header().Set("Content-Type", "application/json")
