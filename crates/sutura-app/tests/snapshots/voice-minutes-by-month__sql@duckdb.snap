---
source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT CAST(DATE_TRUNC('month', "fct_usage_daily"."usage_date") AS DATE) AS "period", SUM("fct_usage_daily"."voice_min") AS "voice_minutes" FROM "fct_usage_daily" WHERE "fct_usage_daily"."usage_date" >= ? AND "fct_usage_daily"."usage_date" < ? GROUP BY CAST(DATE_TRUNC('month', "fct_usage_daily"."usage_date") AS DATE) ORDER BY CAST(DATE_TRUNC('month', "fct_usage_daily"."usage_date") AS DATE) LIMIT 10001
