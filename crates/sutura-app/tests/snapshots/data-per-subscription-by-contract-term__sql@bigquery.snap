SELECT `fct_subscription_monthly`.`contract_term` AS `contract_term`, CAST(DATE_TRUNC(`fct_usage_daily`.`usage_date`, MONTH) AS DATE) AS `period`, CAST(sum(`fct_usage_daily`.`data_gb`) AS FLOAT64) / NULLIF(COUNT(DISTINCT `fct_usage_daily`.`subscription_key`), 0) AS `data_per_subscription` FROM `fct_usage_daily` LEFT JOIN `fct_subscription_monthly` ON `fct_usage_daily`.`subscription_key` = `fct_subscription_monthly`.`subscription_key` AND CAST(DATE_TRUNC(`fct_usage_daily`.`usage_date`, MONTH) AS DATE) = `fct_subscription_monthly`.`month` WHERE `fct_usage_daily`.`usage_date` >= ? AND `fct_usage_daily`.`usage_date` < ? GROUP BY `fct_subscription_monthly`.`contract_term`, CAST(DATE_TRUNC(`fct_usage_daily`.`usage_date`, MONTH) AS DATE) ORDER BY `fct_subscription_monthly`.`contract_term` NULLS LAST, CAST(DATE_TRUNC(`fct_usage_daily`.`usage_date`, MONTH) AS DATE) NULLS LAST LIMIT 10001
