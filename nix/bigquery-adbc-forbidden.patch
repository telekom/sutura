+++ b/forbidden_test.go
@@ -0,0 +1,35 @@
+package bigquery
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/apache/arrow-adbc/go/adbc"
+	"google.golang.org/api/googleapi"
+)
+
+// A REST 403 is Unauthorized only for the reasons a job's status already maps to it.
+func TestForbidden(t *testing.T) {
+	for _, tc := range []struct {
+		code   int
+		reason string
+		want   adbc.Status
+	}{
+		{403, "accessDenied", adbc.StatusUnauthorized},
+		{403, "billingNotEnabled", adbc.StatusUnauthorized},
+		{403, "blocked", adbc.StatusUnauthorized},
+		{403, "", adbc.StatusInternal},
+		{403, "rateLimitExceeded", adbc.StatusInternal},
+		{403, "quotaExceeded", adbc.StatusInternal},
+		{400, "accessDenied", adbc.StatusInvalidArgument},
+	} {
+		apiErr := &googleapi.Error{Code: tc.code, Message: "denied"}
+		if tc.reason != "" {
+			apiErr.Errors = []googleapi.ErrorItem{{Reason: tc.reason}}
+		}
+		var got adbc.Error
+		if !errors.As(errToAdbcErr(adbc.StatusInternal, apiErr, "run a job"), &got) || got.Code != tc.want {
+			t.Errorf("%d %q: got %v, want %v", tc.code, tc.reason, got.Code, tc.want)
+		}
+	}
+}
