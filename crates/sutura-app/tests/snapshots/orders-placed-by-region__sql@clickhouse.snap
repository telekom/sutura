---
source: crates/sutura-app/tests/golden.rs
expression: query.sql()
---
SELECT "customers"."region_code" AS "region", CAST(dateTrunc('month', "orders"."order_date") AS DATE) AS "period", COUNT("orders"."order_id") AS "orders_placed" FROM "orders" JOIN "customers" ON "orders"."customer_id" = "customers"."id" WHERE "orders"."order_date" >= ? AND "orders"."order_date" < ? GROUP BY "customers"."region_code", CAST(dateTrunc('month', "orders"."order_date") AS DATE) ORDER BY "customers"."region_code", CAST(dateTrunc('month', "orders"."order_date") AS DATE) LIMIT 10000
