+    #[serde(default, deserialize_with = "one_or_many")]
     shared_calendar: Option<Vec<ModelName>>,
 }
 
+#[derive(serde::Deserialize)]
+#[serde(untagged)]
+enum OneOrMany {
+    One(ModelName),
+    Many(Vec<ModelName>),
+}
+
+fn one_or_many<'de, D: serde::Deserializer<'de>>(deserializer: D) -> Result<Option<Vec<ModelName>>, D::Error> {
+    use serde::Deserialize;
+    Ok(Option::<OneOrMany>::deserialize(deserializer)?.map(|any| match any {
+        OneOrMany::One(model) => vec![model],
+        OneOrMany::Many(models) => models,
+    }))
+}
