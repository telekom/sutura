---
source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT CAST(dateTrunc('month', "fct_usage_daily"."usage_date") AS DATE) AS "period", if(toTypeName(sum("fct_usage_daily"."voice_min")) IN ('Int64', 'UInt64', 'Nullable(Int64)', 'Nullable(UInt64)'), toDecimal128(sum(accurateCastOrNull("fct_usage_daily"."voice_min", 'Int128')), 0), toDecimal128(sum("fct_usage_daily"."voice_min"), 0)) AS "voice_minutes" FROM "fct_usage_daily" WHERE "fct_usage_daily"."usage_date" >= ? AND "fct_usage_daily"."usage_date" < ? GROUP BY CAST(dateTrunc('month', "fct_usage_daily"."usage_date") AS DATE) ORDER BY CAST(dateTrunc('month', "fct_usage_daily"."usage_date") AS DATE) LIMIT 10001
