---
source: crates/sutura-mcp/src/tool.rs
expression: "canonical(&serde_json::Value::Object(input_schema(capability)), 0)"
---
{
  "$defs": {
    "FilterArgs": {
      "description": "One filter: a dimension, and what it must - or must not - equal.\n\nTagged by `op`, mirroring `sutura_domain::query::Filter` - `github.com/telekom/sutura#968`. Every\nvalue, in either shape, is still checked against the metric's own allowlist; `In`/`NotIn` widen\nthe predicate's shape and never the source of a value.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The dimension equals this one value.",
          "properties": {
            "dimension": {
              "description": "The dimension to filter on, by the name the metric declares it under.",
              "type": "string"
            },
            "op": {
              "const": "eq",
              "type": "string"
            },
            "value": {
              "description": "The value it must equal. Where the catalog declares an allowlist, only a declared\nvalue is accepted.",
              "type": "string"
            }
          },
          "required": [
            "op",
            "dimension",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The dimension equals one of these values. At least one.",
          "properties": {
            "dimension": {
              "description": "The dimension to filter on, by the name the metric declares it under.",
              "type": "string"
            },
            "op": {
              "const": "in",
              "type": "string"
            },
            "values": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "op",
            "dimension",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The dimension equals none of these values. At least one. A row whose value for this\ndimension is unmatched/NULL (an unresolved join key) is excluded, not included.",
          "properties": {
            "dimension": {
              "description": "The dimension to filter on, by the name the metric declares it under.",
              "type": "string"
            },
            "op": {
              "const": "not_in",
              "type": "string"
            },
            "values": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "op",
            "dimension",
            "values"
          ],
          "type": "object"
        }
      ]
    },
    "LastArgs": {
      "additionalProperties": false,
      "description": "A count of calendar periods before today, resolved at request time rather than authored as\ndates - `telekom/sutura#778`.",
      "properties": {
        "count": {
          "description": "How many `unit`s back. Must not be zero.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "include_current": {
          "default": false,
          "description": "Whether today's own, possibly partial, period is included.",
          "type": "boolean"
        },
        "unit": {
          "description": "One of `day`, `week`, `month`, `quarter` or `year`.",
          "type": "string"
        }
      },
      "required": [
        "count",
        "unit"
      ],
      "type": "object"
    },
    "RangeArgs": {
      "additionalProperties": false,
      "description": "A half-open period: `start` is included, `end` is not. Either an absolute period\n(`start`/`end`) or a period relative to today (`last`) - never both, never neither.\n\nHalf-open at every grain, which is what makes a month `[2026-06-01, 2026-07-01)` rather than a\nlast day that differs per month. Both dates are ISO `YYYY-MM-DD`.",
      "properties": {
        "end": {
          "description": "The first day NOT included, as `YYYY-MM-DD` - for example `2026-07-01`. Mutually exclusive\nwith `last`.",
          "type": [
            "string",
            "null"
          ]
        },
        "last": {
          "anyOf": [
            {
              "$ref": "#/$defs/LastArgs"
            },
            {
              "type": "null"
            }
          ],
          "description": "A period ending today (or yesterday, unless `include_current`), resolved against this\ndeployment's own clock. Mutually exclusive with `start`/`end`."
        },
        "start": {
          "description": "The first day included, as `YYYY-MM-DD` - for example `2026-06-01`. Mutually exclusive\nwith `last`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "TopArgs": {
      "additionalProperties": false,
      "description": "A `top` clause: rank by `by`, in `direction`, keep the first `n`.",
      "properties": {
        "by": {
          "description": "`metric` ranks by the question's own measure; `period` ranks by the time bucket.",
          "type": "string"
        },
        "direction": {
          "description": "`desc` for the largest first, `asc` for the smallest.",
          "type": "string"
        },
        "n": {
          "description": "How many groups to return. Must be positive, and no more than this deployment will\ncertify - a larger count is the same refusal an unbounded question over that many groups\nalready gets.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "n",
        "by",
        "direction"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One governed question, as a tool call carries it.\n\nThe six fields are the whole input surface of this deployment. There is no field for SQL, a\ntable, a filter expression or a row-id list, and an argument naming one is a parse error rather\nthan a key that gets ignored.",
  "properties": {
    "dimensions": {
      "default": [],
      "description": "What to group the answer by. At most four, and each must be a dimension the metric declares.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "filters": {
      "description": "Filters, each on a dimension the metric declares as filterable and each value one the\ncatalog allowlists - equality, or membership in an allowed set.",
      "items": {
        "$ref": "#/$defs/FilterArgs"
      },
      "type": "array"
    },
    "grain": {
      "description": "The time resolution to aggregate to: one of `day`, `week`, `month`, `quarter` or `year`, and\nonly those the metric declares.",
      "type": "string"
    },
    "metrics": {
      "description": "The metrics to ask about, by the names this catalog defines them under - for example\n`[\"revenue\"]`. Naming more than one is accepted only when every one shares a model, a time\ncolumn, a grain and every dimension listed below (`github.com/telekom/sutura#968`), and\neven then this deployment executes just one metric at a time today, so a set of more than\none is always refused - ask about each metric separately.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "range": {
      "$ref": "#/$defs/RangeArgs",
      "description": "The half-open period to ask about."
    },
    "top": {
      "anyOf": [
        {
          "$ref": "#/$defs/TopArgs"
        },
        {
          "type": "null"
        }
      ],
      "description": "An order and a caller-chosen row limit, bounding a wide group-by instead of asking for\nevery group - `github.com/telekom/sutura#777`."
    }
  },
  "required": [
    "metrics",
    "grain",
    "range"
  ],
  "title": "AskArgs",
  "type": "object"
}
