SELECT "dim_customer"."customer_key" AS "0_link", "dim_customer"."region" AS "region" FROM "dim_customer" GROUP BY "dim_customer"."customer_key", "dim_customer"."region" ORDER BY "dim_customer"."customer_key", "dim_customer"."region"
