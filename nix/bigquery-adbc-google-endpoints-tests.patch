+func TestGoogleTLSMaterialRefusesPartialBundles(t *testing.T) {
+	ca, cert, key, _ := googleTLSFixture(t)
+	valid, err := os.ReadFile(ca)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, suffix := range []string{"not a certificate", "-----BEGIN CERTIFICATE-----\nbroken\n-----END CERTIFICATE-----\n", "-----BEGIN CERTIFICATE-----\nbroken\n"} {
+		for _, before := range []bool{false, true} {
+			data := append(append([]byte{}, valid...), []byte(suffix)...)
+			if before {
+				data = append([]byte(suffix), valid...)
+			}
+			invalid := filepath.Join(t.TempDir(), "invalid.pem")
+			if err := os.WriteFile(invalid, data, 0600); err != nil {
+				t.Fatal(err)
+			}
+			for _, declaration := range []googleDestinations{{caFile: invalid}, {certFile: invalid, keyFile: key}} {
+				if _, err := declaration.tlsConfig(); err == nil {
+					t.Fatalf("partial bundle accepted: suffix %q before %v", suffix, before)
+				}
+			}
+		}
+	}
+	keyData, err := os.ReadFile(key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	badKey := filepath.Join(t.TempDir(), "key.pem")
+	if err := os.WriteFile(badKey, append(keyData, []byte("broken trailing key")...), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := (googleDestinations{certFile: cert, keyFile: badKey}).tlsConfig(); err == nil {
+		t.Fatal("partial key accepted")
+	}
+	t.Run("startup", func(t *testing.T) {
+		ca, cert, key, _ := googleTLSFixture(t)
+		_, _, otherKey, _ := googleTLSFixture(t)
+		valid, err := os.ReadFile(ca)
+		if err != nil {
+			t.Fatal(err)
+		}
+		keyData, err := os.ReadFile(key)
+		if err != nil {
+			t.Fatal(err)
+		}
+		dir := t.TempDir()
+		files := map[string][]byte{
+			"empty":        {},
+			"over-cap":     append(append([]byte{}, valid...), []byte(strings.Repeat(" ", (4<<20)+1-len(valid)))...),
+			"over-cap-key": append(append([]byte{}, keyData...), []byte(strings.Repeat(" ", (4<<20)+1-len(keyData)))...),
+			"headers":      []byte(strings.Replace(string(valid), "-----BEGIN CERTIFICATE-----\n", "-----BEGIN CERTIFICATE-----\nHeader: refused\n\n", 1)),
+			"two-keys":     append(append([]byte{}, keyData...), keyData...),
+		}
+		for name, data := range files {
+			if err := os.WriteFile(filepath.Join(dir, name), data, 0600); err != nil {
+				t.Fatal(err)
+			}
+		}
+		for name, declaration := range map[string]googleDestinations{
+			"missing-ca":           {caFile: filepath.Join(dir, "missing")},
+			"empty-ca":             {caFile: filepath.Join(dir, "empty")},
+			"over-cap-ca":          {caFile: filepath.Join(dir, "over-cap")},
+			"over-cap-certificate": {certFile: filepath.Join(dir, "over-cap"), keyFile: key},
+			"over-cap-key":         {certFile: cert, keyFile: filepath.Join(dir, "over-cap-key")},
+			"pem-headers":          {caFile: filepath.Join(dir, "headers")},
+			"multiple-keys":        {certFile: cert, keyFile: filepath.Join(dir, "two-keys")},
+			"wrong-key-type":       {certFile: cert, keyFile: ca},
+			"mismatched-key":       {certFile: cert, keyFile: otherKey},
+			"missing-key":          {certFile: cert},
+			"missing-certificate":  {keyFile: key},
+		} {
+			t.Run(name, func(t *testing.T) {
+				if _, err := declaration.tlsConfig(); err == nil {
+					t.Fatalf("invalid TLS declaration %s was accepted", name)
+				}
+			})
+		}
+		atCap := filepath.Join(dir, "at-cap")
+		valid = append(valid, []byte(strings.Repeat(" ", (4<<20)-len(valid)))...)
+		if err := os.WriteFile(atCap, valid, 0600); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := (googleDestinations{caFile: atCap}).tlsConfig(); err != nil {
+			t.Fatalf("valid CA bundle exactly at the cap was refused: %v", err)
+		}
+
+	})
+
+}
