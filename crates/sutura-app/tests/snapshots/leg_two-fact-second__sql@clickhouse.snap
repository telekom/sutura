source: crates/sutura-app/tests/golden/legs.rs
expression: query.sql()
---
SELECT "fct_ticket_monthly"."customer_key" AS "0_link", CAST(dateTrunc('month', "dim_calendar"."month") AS DATE) AS "period", if(toTypeName(sum("fct_ticket_monthly"."tickets")) IN ('Int64', 'Nullable(Int64)', 'UInt64', 'Nullable(UInt64)', 'Int128', 'Nullable(Int128)'), tuple('Int128', toDecimal256(sum(accurateCastOrNull("fct_ticket_monthly"."tickets", 'Int128')), 0), CAST(NULL AS Nullable(Decimal(76, 38))), CAST(NULL AS Nullable(Float64))), tuple(toTypeName(sum("fct_ticket_monthly"."tickets")), CAST(NULL AS Nullable(Decimal(76, 0))), if(toTypeName(sum("fct_ticket_monthly"."tickets")) LIKE '%Decimal(%', toDecimal256(sum("fct_ticket_monthly"."tickets"), 38), NULL), if(toTypeName(sum("fct_ticket_monthly"."tickets")) LIKE '%Float%', toFloat64(sum("fct_ticket_monthly"."tickets")), NULL))) AS "0_leaf_0" FROM "fct_ticket_monthly" LEFT JOIN "dim_calendar" ON "fct_ticket_monthly"."month" = "dim_calendar"."month" WHERE "dim_calendar"."month" >= ? AND "dim_calendar"."month" < ? GROUP BY "fct_ticket_monthly"."customer_key", CAST(dateTrunc('month', "dim_calendar"."month") AS DATE) ORDER BY "fct_ticket_monthly"."customer_key", CAST(dateTrunc('month', "dim_calendar"."month") AS DATE)
