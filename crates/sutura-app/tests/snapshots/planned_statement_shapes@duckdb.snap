---
source: crates/sutura-app/tests/golden/statements.rs
expression: corpus
---
join_left_filter_limit
SELECT CAST("a"."subscription_key" AS BIGINT) AS "left_key", CAST("b"."subscription_key" AS BIGINT) AS "right_key", CAST(date_part('DAY', "a"."usage_date") AS BIGINT) AS "usage_day", CAST(date_part('MONTH', "b"."month") AS BIGINT) AS "billing_month" FROM (SELECT "fct_usage_daily"."usage_date", "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ((("fct_usage_daily"."subscription_key" >= 1001) AND ("fct_usage_daily"."subscription_key" <= 1002)) AND ("fct_usage_daily"."voice_min" = 0.0))) AS "a" INNER JOIN "fct_subscription_monthly" AS "b" ON "a"."subscription_key" = "b"."subscription_key" WHERE (("b"."subscription_key" >= 1001) AND ("b"."subscription_key" <= 1002)) LIMIT 200

join_right_filter_limit
SELECT CAST("a"."subscription_key" AS BIGINT) AS "left_key", CAST("b"."subscription_key" AS BIGINT) AS "right_key", CAST(date_part('DAY', "a"."usage_date") AS BIGINT) AS "usage_day", CAST(date_part('MONTH', "b"."month") AS BIGINT) AS "billing_month" FROM "fct_usage_daily" AS "a" INNER JOIN "fct_subscription_monthly" AS "b" ON "a"."subscription_key" = "b"."subscription_key" WHERE (("a"."subscription_key" >= 1001) AND ("a"."subscription_key" <= 1002)) AND ((("b"."month" >= CAST('2026-04-01' AS DATE)) AND ("b"."subscription_key" >= 1001)) AND ("b"."subscription_key" <= 1002)) LIMIT 200

join_no_filter_limit
SELECT CAST("a"."subscription_key" AS BIGINT) AS "left_key", CAST("b"."subscription_key" AS BIGINT) AS "right_key", CAST(date_part('DAY', "a"."usage_date") AS BIGINT) AS "usage_day", CAST(date_part('MONTH', "b"."month") AS BIGINT) AS "billing_month" FROM "fct_usage_daily" AS "a" INNER JOIN "fct_subscription_monthly" AS "b" ON "a"."subscription_key" = "b"."subscription_key" WHERE (("a"."subscription_key" >= 1001) AND ("a"."subscription_key" <= 1002)) AND (("b"."subscription_key" >= 1001) AND ("b"."subscription_key" <= 1002)) LIMIT 200

join_unaliased_filter_limit
SELECT CAST("fct_usage_daily"."subscription_key" AS BIGINT) AS "left_key", CAST("fct_subscription_monthly"."subscription_key" AS BIGINT) AS "right_key", CAST(date_part('DAY', "fct_usage_daily"."usage_date") AS BIGINT) AS "usage_day", CAST(date_part('MONTH', "fct_subscription_monthly"."month") AS BIGINT) AS "billing_month" FROM (SELECT "fct_usage_daily"."usage_date", "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ((("fct_usage_daily"."subscription_key" >= 1001) AND ("fct_usage_daily"."subscription_key" <= 1002)) AND ("fct_usage_daily"."voice_min" = 0.0))) AS "fct_usage_daily" INNER JOIN "fct_subscription_monthly" ON "fct_usage_daily"."subscription_key" = "fct_subscription_monthly"."subscription_key" WHERE (("fct_subscription_monthly"."subscription_key" >= 1001) AND ("fct_subscription_monthly"."subscription_key" <= 1002)) LIMIT 200

join_ordered_filter_limit
SELECT CAST("a"."subscription_key" AS BIGINT) AS "left_key", CAST("b"."subscription_key" AS BIGINT) AS "right_key", CAST(date_part('DAY', "a"."usage_date") AS BIGINT) AS "usage_day", CAST(date_part('MONTH', "b"."month") AS BIGINT) AS "billing_month" FROM (SELECT "fct_usage_daily"."usage_date", "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ((("fct_usage_daily"."subscription_key" >= 1001) AND ("fct_usage_daily"."subscription_key" <= 1002)) AND ("fct_usage_daily"."voice_min" = 0.0))) AS "a" INNER JOIN "fct_subscription_monthly" AS "b" ON "a"."subscription_key" = "b"."subscription_key" WHERE (("b"."subscription_key" >= 1001) AND ("b"."subscription_key" <= 1002)) ORDER BY "usage_day" DESC NULLS FIRST, "billing_month" ASC NULLS LAST LIMIT 5 OFFSET 2

join_filter_without_limit
SELECT CAST("a"."subscription_key" AS BIGINT) AS "left_key", CAST("b"."subscription_key" AS BIGINT) AS "right_key", CAST(date_part('DAY', "a"."usage_date") AS BIGINT) AS "usage_day", CAST(date_part('MONTH', "b"."month") AS BIGINT) AS "billing_month" FROM (SELECT "fct_usage_daily"."usage_date", "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ((("fct_usage_daily"."subscription_key" >= 1001) AND ("fct_usage_daily"."subscription_key" <= 1002)) AND ("fct_usage_daily"."voice_min" = 0.0))) AS "a" INNER JOIN "fct_subscription_monthly" AS "b" ON "a"."subscription_key" = "b"."subscription_key" WHERE (("b"."subscription_key" >= 1001) AND ("b"."subscription_key" <= 1002))

join_nested_windows
SELECT * FROM (SELECT CAST("a"."subscription_key" AS BIGINT) AS "left_key", CAST("b"."subscription_key" AS BIGINT) AS "right_key", CAST(date_part('DAY', "a"."usage_date") AS BIGINT) AS "usage_day", CAST(date_part('MONTH', "b"."month") AS BIGINT) AS "billing_month" FROM (SELECT "fct_usage_daily"."usage_date", "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ((("fct_usage_daily"."subscription_key" >= 1001) AND ("fct_usage_daily"."subscription_key" <= 1002)) AND ("fct_usage_daily"."voice_min" = 0.0))) AS "a" INNER JOIN "fct_subscription_monthly" AS "b" ON ("a"."subscription_key" + 1) = "b"."subscription_key" ORDER BY "usage_day" DESC NULLS FIRST, "billing_month" ASC NULLS LAST LIMIT 8 OFFSET 1) AS "q" ORDER BY "q"."billing_month" DESC NULLS FIRST, "q"."usage_day" ASC NULLS LAST LIMIT 3 OFFSET 2

join_limited_input
SELECT CAST("a"."subscription_key" AS BIGINT) AS "left_key", CAST("b"."subscription_key" AS BIGINT) AS "right_key", CAST(date_part('DAY', "a"."usage_date") AS BIGINT) AS "usage_day", 0 AS "billing_month" FROM (SELECT "fct_usage_daily"."usage_date", "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."voice_min" = 0.0)) AS "a" INNER JOIN (SELECT "fct_subscription_monthly"."subscription_key" FROM "fct_subscription_monthly" WHERE ("fct_subscription_monthly"."subscription_key" = 1003) LIMIT 2 OFFSET 0) AS "b" ON ("a"."subscription_key" + 1) = "b"."subscription_key" LIMIT 200

plain_filter
SELECT CAST("fct_usage_daily"."subscription_key" AS BIGINT) AS "key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)

aliased_filter
SELECT CAST("k"."subscription_key" AS BIGINT) AS "key" FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)) AS "k"

not_null_and_filter
SELECT CAST("fct_usage_daily"."subscription_key" AS BIGINT) AS "key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."usage_date" IS NOT NULL AND ("fct_usage_daily"."subscription_key" = 1002))

count_column_filter
SELECT count("subscription_key") AS "n" FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."voice_min" = 0.0)) AS "fct_usage_daily"

ordered_filter_limit
SELECT "key" FROM (SELECT CAST("fct_usage_daily"."subscription_key" AS BIGINT) AS "key", "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002) ORDER BY "fct_usage_daily"."subscription_key" ASC NULLS LAST LIMIT 2)

grouped_count_star
SELECT CAST("fct_usage_daily"."subscription_key" AS BIGINT) AS "key", count(1) AS "n" FROM "fct_usage_daily" GROUP BY "fct_usage_daily"."subscription_key"

date_comparison
SELECT CAST("fct_usage_daily"."subscription_key" AS BIGINT) AS "key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."usage_date" >= CAST('2026-06-02' AS DATE))

timestamp_comparison
SELECT CAST("fct_usage_daily"."subscription_key" AS BIGINT) AS "key" FROM "fct_usage_daily" WHERE (CAST("fct_usage_daily"."usage_date" AS TIMESTAMP) >= CAST('2026-06-02 00:00:00' AS TIMESTAMP))

date_between
SELECT CAST("fct_usage_daily"."subscription_key" AS BIGINT) AS "key" FROM "fct_usage_daily" WHERE (("fct_usage_daily"."usage_date" >= CAST('2026-06-01' AS DATE)) AND ("fct_usage_daily"."usage_date" <= CAST('2026-06-02' AS DATE)))

date_part_year
SELECT CAST("fct_usage_daily"."subscription_key" AS BIGINT) AS "key" FROM "fct_usage_daily" WHERE (("fct_usage_daily"."usage_date" >= CAST('2026-01-01' AS DATE)) AND ("fct_usage_daily"."usage_date" < CAST('2027-01-01' AS DATE)))

extract_year
SELECT CAST("fct_usage_daily"."subscription_key" AS BIGINT) AS "key" FROM "fct_usage_daily" WHERE (("fct_usage_daily"."usage_date" >= CAST('2026-01-01' AS DATE)) AND ("fct_usage_daily"."usage_date" < CAST('2027-01-01' AS DATE)))

count_star_filter
SELECT count(1) AS "n" FROM (SELECT 1 FROM "fct_usage_daily" WHERE ("fct_usage_daily"."voice_min" = 0.0))

count_one_filter
SELECT count(1) AS "n" FROM (SELECT 1 FROM "fct_usage_daily" WHERE ("fct_usage_daily"."voice_min" = 0.0))

filter_limit
SELECT CAST("fct_usage_daily"."subscription_key" AS BIGINT) AS "key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002) LIMIT 2

filter_wide_limit
SELECT CAST("fct_usage_daily"."subscription_key" AS BIGINT) AS "key", CAST("fct_usage_daily"."voice_min" AS BIGINT) AS "voice" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002) LIMIT 2

count_star
SELECT count(1) AS "n" FROM "fct_usage_daily"

aliased_filter_limit
SELECT CAST("k"."subscription_key" AS BIGINT) AS "key" FROM (SELECT * FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)) AS "k" LIMIT 2 OFFSET 0) AS "k"

aliased_filter_wide_limit
SELECT CAST("k"."subscription_key" AS BIGINT) AS "key", CAST("k"."voice_min" AS BIGINT) AS "voice" FROM (SELECT * FROM (SELECT "fct_usage_daily"."subscription_key", "fct_usage_daily"."voice_min" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)) AS "k" LIMIT 2 OFFSET 0) AS "k"

aliased_ordered_filter_limit
SELECT "key" FROM (SELECT CAST("k"."subscription_key" AS BIGINT) AS "key", "k"."subscription_key" FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)) AS "k" ORDER BY "k"."subscription_key" ASC NULLS LAST LIMIT 2)

correlated_exists
SELECT CAST("k"."subscription_key" AS BIGINT) AS "key" FROM "fct_usage_daily" AS "k" WHERE EXISTS (SELECT 1 FROM (SELECT "x"."subscription_key" FROM "fct_usage_daily" AS "x") AS "__correlated_sq_1" WHERE ("k"."subscription_key" = "__correlated_sq_1"."subscription_key"))

correlated_exists_filter
SELECT CAST("k"."subscription_key" AS BIGINT) AS "key" FROM "fct_usage_daily" AS "k" WHERE EXISTS (SELECT 1 FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)) AS "__correlated_sq_1" WHERE ("k"."subscription_key" = "__correlated_sq_1"."subscription_key"))

self_in_filter
SELECT CAST("k"."subscription_key" AS BIGINT) AS "key" FROM "fct_usage_daily" AS "k" WHERE EXISTS (SELECT 1 FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)) AS "__correlated_sq_1" WHERE ("k"."subscription_key" = "__correlated_sq_1"."subscription_key"))

self_in_filter_wide_limit
SELECT CAST("k"."subscription_key" AS BIGINT) AS "key", CAST("k"."voice_min" AS BIGINT) AS "voice" FROM "fct_usage_daily" AS "k" WHERE EXISTS (SELECT 1 FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)) AS "__correlated_sq_1" WHERE ("k"."subscription_key" = "__correlated_sq_1"."subscription_key")) LIMIT 2

correlated_not_exists_preserves_outer_filter
SELECT CAST("k"."subscription_key" AS BIGINT) AS "key" FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)) AS "k" WHERE NOT EXISTS (SELECT 1 FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE (("fct_usage_daily"."voice_min" < 0.0) AND ("fct_usage_daily"."subscription_key" = 1002))) AS "__correlated_sq_1" WHERE ("k"."subscription_key" = "__correlated_sq_1"."subscription_key"))
