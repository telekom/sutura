source: crates/sutura-app/tests/golden/legs.rs
expression: query.sql()
---
SELECT CAST(DATE_TRUNC(`fct_subscription_monthly`.`usage_date`, MONTH) AS DATE) AS `0_link`, CAST(DATE_TRUNC(`fct_subscription_monthly`.`month`, MONTH) AS DATE) AS `period`, sum(`fct_subscription_monthly`.`voice_min`) AS `0_leaf_0` FROM `fct_subscription_monthly` WHERE `fct_subscription_monthly`.`month` >= ? AND `fct_subscription_monthly`.`month` < ? AND `fct_subscription_monthly`.`status` = ? GROUP BY CAST(DATE_TRUNC(`fct_subscription_monthly`.`usage_date`, MONTH) AS DATE), CAST(DATE_TRUNC(`fct_subscription_monthly`.`month`, MONTH) AS DATE) ORDER BY CAST(DATE_TRUNC(`fct_subscription_monthly`.`usage_date`, MONTH) AS DATE) NULLS LAST, CAST(DATE_TRUNC(`fct_subscription_monthly`.`month`, MONTH) AS DATE) NULLS LAST
