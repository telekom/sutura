@@ -0,0 +1,163 @@
+package bigquery
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/apache/arrow-adbc/go/adbc"
+	"github.com/apache/arrow-go/v18/arrow/memory"
+	"golang.org/x/oauth2"
+	"google.golang.org/api/impersonate"
+	"google.golang.org/api/option"
+)
+
+func openWith(t *testing.T, opts map[string]string) error {
+	t.Helper()
+	ctx := context.Background()
+	opts["bigquery.project_id"] = "test-project"
+	db, err := NewDriver(memory.DefaultAllocator).NewDatabaseWithContext(ctx, opts)
+	if err != nil {
+		return err
+	}
+	cnxn, err := db.Open(ctx)
+	if err == nil {
+		_ = cnxn.Close(ctx)
+	}
+	return err
+}
+
+func wantInvalidArgument(t *testing.T, err error, mentions string) {
+	t.Helper()
+	var adbcErr adbc.Error
+	if !errors.As(err, &adbcErr) || adbcErr.Code != adbc.StatusInvalidArgument || !strings.Contains(adbcErr.Msg, mentions) {
+		t.Fatalf("got %v, want InvalidArgument naming %q", err, mentions)
+	}
+}
+
+// The token reaches BigQuery as the request's bearer credential.
+func TestAccessToken(t *testing.T) {
+	ctx := context.Background()
+	seen := make(chan string, 1)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		// The storage client's gRPC preface also lands here; only a REST call counts.
+		if strings.HasPrefix(r.URL.Path, "/bigquery/v2/") {
+			select {
+			case seen <- r.Header.Get("Authorization"):
+			default:
+			}
+		}
+		http.Error(w, `{"error":{"code":404,"message":"none"}}`, http.StatusNotFound)
+	}))
+	defer srv.Close()
+
+	db, err := NewDriver(memory.DefaultAllocator).NewDatabaseWithContext(ctx, map[string]string{
+		"bigquery.project_id":        "test-project",
+		"bigquery.endpoint":          srv.URL + "/bigquery/v2/",
+		"bigquery.storage_endpoint":  srv.Listener.Addr().String(),
+		"bigquery.auth_type":         "access_token",
+		"bigquery.auth.access_token": "caller-token",
+	})
+	if err != nil {
+		t.Fatalf("database: %v", err)
+	}
+	cnxn, err := db.Open(ctx)
+	if err != nil {
+		t.Fatalf("open: %v", err)
+	}
+	defer cnxn.Close(ctx)
+	stmt, err := cnxn.NewStatement(ctx)
+	if err != nil {
+		t.Fatalf("statement: %v", err)
+	}
+	defer stmt.Close(ctx)
+	if err := stmt.SetSqlQuery(ctx, "SELECT 1"); err != nil {
+		t.Fatalf("query: %v", err)
+	}
+	_, _, _ = stmt.ExecuteQuery(ctx)
+	select {
+	case got := <-seen:
+		if got != "Bearer caller-token" {
+			t.Fatalf("Authorization %q, want the access token", got)
+		}
+	default:
+		t.Fatal("no request reached the endpoint")
+	}
+}
+
+func TestEmptyAccessTokenRefused(t *testing.T) {
+	err := openWith(t, map[string]string{"bigquery.auth_type": "access_token"})
+	wantInvalidArgument(t, err, "bigquery.auth.access_token")
+}
+
+// Impersonation would replace the token with the deployment's own credential.
+func TestAccessTokenUnderImpersonationRefused(t *testing.T) {
+	err := openWith(t, map[string]string{
+		"bigquery.auth_type":                    "access_token",
+		"bigquery.auth.access_token":            "caller-token",
+		"bigquery.impersonate.target_principal": "delegating@test-project.iam.gserviceaccount.com",
+		"bigquery.impersonate.scopes":           "https://www.googleapis.com/auth/bigquery",
+	})
+	wantInvalidArgument(t, err, "cannot be combined with impersonation")
+}
+
+func TestImpersonateSubject(t *testing.T) {
+	var got impersonate.CredentialsConfig
+	stop := errors.New("config observed")
+	defer func(orig func(context.Context, impersonate.CredentialsConfig, ...option.ClientOption) (oauth2.TokenSource, error)) {
+		newImpersonatedTokenSource = orig
+	}(newImpersonatedTokenSource)
+	newImpersonatedTokenSource = func(_ context.Context, cfg impersonate.CredentialsConfig, _ ...option.ClientOption) (oauth2.TokenSource, error) {
+		got = cfg
+		return nil, stop
+	}
+	err := openWith(t, map[string]string{
+		"bigquery.impersonate.target_principal": "delegating@test-project.iam.gserviceaccount.com",
+		"bigquery.impersonate.scopes":           "https://www.googleapis.com/auth/bigquery",
+		"bigquery.impersonate.subject":          "user@example.com",
+	})
+	if err == nil || !strings.Contains(err.Error(), stop.Error()) {
+		t.Fatalf("open: %v, want the observed config to end it", err)
+	}
+	if got.Subject != "user@example.com" || got.TargetPrincipal != "delegating@test-project.iam.gserviceaccount.com" {
+		t.Fatalf("subject %q, target %q", got.Subject, got.TargetPrincipal)
+	}
+}
+
+// A subject alone never falls through to the deployment's own credential.
+func TestSubjectWithoutTargetPrincipalRefused(t *testing.T) {
+	err := openWith(t, map[string]string{"bigquery.impersonate.subject": "user@example.com"})
+	wantInvalidArgument(t, err, "bigquery.impersonate.target_principal")
+}
+
+// The token is refused unless the auth type selects it. Each arm is configured to open on its own,
+// so only that refusal can stop it.
+func TestAccessTokenUnderOtherAuthTypeRefused(t *testing.T) {
+	cred := `{"type":"authorized_user","client_id":"x","client_secret":"y","refresh_token":"z"}`
+	file := filepath.Join(t.TempDir(), "cred.json")
+	if err := os.WriteFile(file, []byte(cred), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	for _, opts := range []map[string]string{
+		{},
+		{OptionAuthType: OptionValueAuthTypeDefault},
+		{OptionAuthType: OptionValueAuthTypeAppDefaultCredentials},
+		{OptionAuthType: OptionValueAuthTypeJSONCredentialFile, OptionAuthCredentials: file},
+		{OptionAuthType: OptionValueAuthTypeJSONCredentialString, OptionAuthCredentials: cred},
+		{
+			OptionAuthType:         OptionValueAuthTypeUserAuthentication,
+			OptionAuthClientID:     "x",
+			OptionAuthClientSecret: "y",
+			OptionAuthRefreshToken: "z",
+		},
+		{OptionAuthType: OptionValueAuthTypeAnonymous},
+	} {
+		opts[OptionAuthAccessToken] = "caller-token"
+		wantInvalidArgument(t, openWith(t, opts), "requires `bigquery.auth_type=access_token`")
+	}
+}
