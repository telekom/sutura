---
source: crates/sutura-app/tests/golden/catalogs.rs
expression: plan
---
source: local
measures:
  - metric: voice_minutes
    label: voice_minutes
    measure:
      simple:
        term:
          aggregate:
            aggregate: sum
            column:
              table: fct_usage_daily
              column: voice_min
    guard: []
table: fct_usage_daily
joins:
  - relationship: usage_subscription
    table: fct_subscription_monthly
    join_type: many_to_one
    keys:
      - Equal:
          origin:
            table: fct_usage_daily
            column: subscription_key
          target:
            table: fct_subscription_monthly
            column: subscription_key
      - TruncatedEqual:
          origin:
            table: fct_usage_daily
            column: usage_date
          grain: month
          target:
            table: fct_subscription_monthly
            column: month
  - relationship: subscription_product
    table: dim_product
    join_type: many_to_one
    keys:
      - Equal:
          origin:
            table: fct_subscription_monthly
            column: product_key
          target:
            table: dim_product
            column: product_key
bucket:
  label: period
  grain: month
  column:
    table: fct_usage_daily
    column: usage_date
keys:
  - label: product_family
    column:
      table: dim_product
      column: product_family
filters:
  - origin: definition
    predicate:
      at_or_after:
        column:
          table: fct_usage_daily
          column: usage_date
        param: 0
  - origin: definition
    predicate:
      before:
        column:
          table: fct_usage_daily
          column: usage_date
        param: 1
params:
  - Date: 2026-06-01
  - Date: 2026-07-01
range:
  start: 2026-06-01
  end: 2026-07-01
max_rows: 10000
top: ~
