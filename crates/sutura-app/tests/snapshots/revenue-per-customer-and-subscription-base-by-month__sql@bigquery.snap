---
source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT CAST(DATE_TRUNC(`fct_subscription_monthly`.`month`, MONTH) AS DATE) AS `period`, CAST(sum(CASE WHEN `fct_subscription_monthly`.`status` = ? THEN `fct_subscription_monthly`.`mrr_cents` END) AS FLOAT64) / NULLIF(COUNT(DISTINCT CASE WHEN `fct_subscription_monthly`.`status` = ? THEN `fct_subscription_monthly`.`customer_key` END), 0) AS `revenue_per_customer`, COUNT(DISTINCT `fct_subscription_monthly`.`subscription_key`) AS `subscription_base` FROM `fct_subscription_monthly` WHERE `fct_subscription_monthly`.`month` >= ? AND `fct_subscription_monthly`.`month` < ? GROUP BY CAST(DATE_TRUNC(`fct_subscription_monthly`.`month`, MONTH) AS DATE) ORDER BY CAST(DATE_TRUNC(`fct_subscription_monthly`.`month`, MONTH) AS DATE) NULLS LAST LIMIT 10001
