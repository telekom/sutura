---
source: crates/sutura-app/tests/golden/statements.rs
expression: corpus
---
plain_filter
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002)

not_null_and_filter
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."usage_date" IS NOT NULL AND ("fct_usage_daily"."subscription_key" = 1002))

count_column_filter
SELECT count("subscription_key") AS "n" FROM (SELECT "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."voice_min" = 0.0))

ordered_filter_limit
SELECT "key" FROM (SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key", "fct_usage_daily"."subscription_key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002) ORDER BY "fct_usage_daily"."subscription_key" ASC NULLS LAST FETCH FIRST 2 ROWS ONLY)

grouped_count_star
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key", count(1) AS "n" FROM "fct_usage_daily" GROUP BY "fct_usage_daily"."subscription_key"

date_comparison
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."usage_date" >= TIMESTAMP '2026-06-02 00:00:00')

timestamp_comparison
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."usage_date" >= TIMESTAMP '2026-06-02 00:00:00')

date_between
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" WHERE (("fct_usage_daily"."usage_date" >= TIMESTAMP '2026-06-01 00:00:00') AND ("fct_usage_daily"."usage_date" <= TIMESTAMP '2026-06-02 00:00:00'))

date_part_year
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" WHERE (("fct_usage_daily"."usage_date" >= TIMESTAMP '2026-01-01 00:00:00') AND ("fct_usage_daily"."usage_date" < TIMESTAMP '2027-01-01 00:00:00'))

extract_year
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" WHERE (("fct_usage_daily"."usage_date" >= TIMESTAMP '2026-01-01 00:00:00') AND ("fct_usage_daily"."usage_date" < TIMESTAMP '2027-01-01 00:00:00'))

count_star_filter
SELECT count(1) AS "n" FROM (SELECT 1 FROM "fct_usage_daily" WHERE ("fct_usage_daily"."voice_min" = 0.0))

count_one_filter
SELECT count(1) AS "n" FROM (SELECT 1 FROM "fct_usage_daily" WHERE ("fct_usage_daily"."voice_min" = 0.0))

filter_limit
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002) FETCH FIRST 2 ROWS ONLY

filter_wide_limit
SELECT CAST("fct_usage_daily"."subscription_key" AS INTEGER) AS "key", CAST("fct_usage_daily"."voice_min" AS INTEGER) AS "voice" FROM "fct_usage_daily" WHERE ("fct_usage_daily"."subscription_key" = 1002) FETCH FIRST 2 ROWS ONLY

count_star
SELECT count(1) AS "n" FROM "fct_usage_daily"
