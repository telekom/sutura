---
source: crates/sutura-app/tests/golden/catalogs.rs
expression: pinned.definitions()
---
models:
  bigquery__customers:
    name: bigquery__customers
    source: local
    table: customers
    columns:
      customer_id:
        name: customer_id
        data_type: ~
        description: ""
        nullable: ~
      segment:
        name: segment
        data_type: ~
        description: ""
        nullable: ~
    primary_key: []
    description: The customer dimension.
  bigquery__orders:
    name: bigquery__orders
    source: local
    table: orders
    columns:
      amount_cents:
        name: amount_cents
        data_type: NUMERIC
        description: "The order total, in minor units."
        nullable: ~
      customer_id:
        name: customer_id
        data_type: ~
        description: ""
        nullable: ~
      order_date:
        name: order_date
        data_type: ~
        description: ""
        nullable: ~
      order_id:
        name: order_id
        data_type: ~
        description: ""
        nullable: ~
      status:
        name: status
        data_type: ~
        description: ""
        nullable: ~
    primary_key:
      - order_id
    description: "Net revenue orders, in minor units."
relationships:
  orders_to_customer:
    name: orders_to_customer
    origin_model: bigquery__orders
    target_model: bigquery__customers
    join_type: many_to_one
    keys:
      - Equal:
          origin: customer_id
          target: customer_id
metrics:
  revenue:
    name: revenue
    model: bigquery__orders
    measure:
      simple:
        aggregate: sum
        column: amount_cents
    required_filters:
      - equals:
          column: status
          value: active
    time_column: order_date
    grains:
      - month
    dimensions:
      segment:
        name: segment
        column: segment
        via:
          - orders_to_customer
        allowed_values:
          - retail
          - wholesale
        description: "The customer's segment."
    anchor:
      range:
        start: 2026-06-01
        end: 2026-07-01
      value: "412345"
    description: "Net revenue in minor units, from active orders."
    audience: Open
