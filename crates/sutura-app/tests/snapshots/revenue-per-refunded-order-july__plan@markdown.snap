---
source: crates/sutura-app/tests/golden/catalogs.rs
expression: plan
---
source: local
metric: revenue_per_refunded_order
table: orders
joins: []
bucket:
  label: period
  grain: month
  column:
    table: orders
    column: order_date
keys: []
measure:
  ratio:
    numerator:
      aggregate:
        aggregate: sum
        column:
          table: orders
          column: amount_cents
    denominator:
      count_if:
        column:
          table: orders
          column: refunded
    zero_denominator: fails
measure_label: revenue_per_refunded_order
filters:
  - origin: definition
    predicate:
      at_or_after:
        column:
          table: orders
          column: order_date
        param: 0
  - origin: definition
    predicate:
      before:
        column:
          table: orders
          column: order_date
        param: 1
params:
  - Date:
      year: 2026
      month: 7
      day: 1
  - Date:
      year: 2026
      month: 8
      day: 1
range:
  start:
    year: 2026
    month: 7
    day: 1
  end:
    year: 2026
    month: 8
    day: 1
row_limit: 10000
