---
source: crates/sutura-cli/tests/example.rs
expression: rendered(&query)
---
SELECT "dim_region"."sales_area" AS "sales_area", CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) AS "period", SUM("fct_subscription_monthly"."mrr_cents") AS "recurring_revenue" FROM "fct_subscription_monthly" LEFT JOIN "dim_customer" ON "fct_subscription_monthly"."customer_key" = "dim_customer"."customer_key" LEFT JOIN "dim_region" ON "dim_customer"."region" = "dim_region"."region" WHERE "fct_subscription_monthly"."month" >= ? AND "fct_subscription_monthly"."month" < ? AND "fct_subscription_monthly"."status" = ? GROUP BY "dim_region"."sales_area", CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) ORDER BY "dim_region"."sales_area" NULLS LAST, CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) NULLS LAST LIMIT 10001
-- $1 = 2026-06-01
-- $2 = 2026-07-01
-- $3 = "active"
