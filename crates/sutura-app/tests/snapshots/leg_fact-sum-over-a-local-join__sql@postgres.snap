---
source: crates/sutura-app/tests/golden/legs.rs
expression: query.sql()
---
SELECT "dim_product"."product_family" AS "product_family", "fct_subscription_monthly"."customer_key" AS "customer_key", CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) AS "period", SUM("fct_subscription_monthly"."mrr_cents") AS "recurring_revenue" FROM "fct_subscription_monthly" LEFT JOIN "dim_product" ON "fct_subscription_monthly"."product_key" = "dim_product"."product_key" WHERE "fct_subscription_monthly"."month" >= $1 AND "fct_subscription_monthly"."month" < $2 AND "fct_subscription_monthly"."status" = $3 GROUP BY "dim_product"."product_family", "fct_subscription_monthly"."customer_key", CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE) ORDER BY "dim_product"."product_family", "fct_subscription_monthly"."customer_key", CAST(DATE_TRUNC('month', "fct_subscription_monthly"."month") AS DATE)
