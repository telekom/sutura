---
source: crates/sutura-app/tests/golden/catalogs.rs
expression: plan
---
source: local
metric: subscriptions_churned
table: fct_subscription_monthly
joins: []
bucket:
  label: period
  grain: month
  column:
    table: fct_subscription_monthly
    column: month
keys: []
measure:
  simple:
    term:
      count_if:
        column:
          table: fct_subscription_monthly
          column: churned_in_month
measure_label: subscriptions_churned
filters:
  - origin: definition
    predicate:
      at_or_after:
        column:
          table: fct_subscription_monthly
          column: month
        param: 0
  - origin: definition
    predicate:
      before:
        column:
          table: fct_subscription_monthly
          column: month
        param: 1
params:
  - Date:
      year: 2026
      month: 1
      day: 1
  - Date:
      year: 2026
      month: 7
      day: 1
range:
  start:
    year: 2026
    month: 1
    day: 1
  end:
    year: 2026
    month: 7
    day: 1
max_rows: 10000
