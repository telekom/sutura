+func TestGoogleDeclaredTrustHandshake(t *testing.T) {
+	ca, cert, key, roots := googleTLSFixture(t)
+	caData, err := os.ReadFile(ca)
+	if err != nil {
+		t.Fatal(err)
+	}
+	certificates, err := googleCertificates(caData)
+	if err != nil {
+		t.Fatal(err)
+	}
+	caIdentity, err := tls.LoadX509KeyPair(cert, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	serverKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{SerialNumber: big.NewInt(2), DNSNames: []string{"bigquery-example.p.googleapis.com"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}
+	serverDER, err := x509.CreateCertificate(rand.Reader, template, certificates[0], &serverKey.PublicKey, caIdentity.PrivateKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if len(r.TLS.PeerCertificates) != 1 {
+			t.Error("declared client identity absent at server")
+		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	server.Config.ErrorLog = log.New(io.Discard, "", 0)
+	server.TLS = &tls.Config{MinVersion: tls.VersionTLS12, Certificates: []tls.Certificate{{Certificate: [][]byte{serverDER}, PrivateKey: serverKey}}, ClientAuth: tls.RequireAndVerifyClientCert, ClientCAs: roots}
+	server.StartTLS()
+	defer server.Close()
+	config, err := (googleDestinations{caFile: ca, certFile: cert, keyFile: key}).tlsConfig()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, venue := range []string{"https", "storage"} {
+		for _, variant := range []string{"declared", "wrong_roots", "wrong_name", "no_client"} {
+			t.Run(venue+"/"+variant, func(t *testing.T) {
+				selected := config.Clone()
+				authority := "bigquery-example.p.googleapis.com:443"
+				if variant == "wrong_roots" {
+					selected.RootCAs = x509.NewCertPool()
+				}
+				if variant == "wrong_name" {
+					authority = "different-example.p.googleapis.com:443"
+				}
+				if variant == "no_client" {
+					selected.Certificates = nil
+				}
+				ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+				defer cancel()
+				var got error
+				if venue == "https" {
+					transport := googleBaseTransport(selected).(*http.Transport)
+					transport.Proxy = nil
+					transport.DialContext = func(ctx context.Context, network, address string) (net.Conn, error) {
+						return (&net.Dialer{}).DialContext(ctx, network, server.Listener.Addr().String())
+					}
+					defer transport.CloseIdleConnections()
+					request, err := http.NewRequestWithContext(ctx, "GET", "https://"+authority+"/", nil)
+					if err != nil {
+						t.Fatal(err)
+					}
+					response, err := googleHTTPClient(transport).Do(request)
+					got = err
+					if response != nil {
+						response.Body.Close()
+					}
+				} else {
+					listener, err := net.Listen("tcp", "127.0.0.1:0")
+					if err != nil {
+						t.Fatal(err)
+					}
+					defer listener.Close()
+					serverConfig := server.TLS.Clone()
+					serverConfig.NextProtos = []string{"h2"}
+					go func() {
+						raw, err := listener.Accept()
+						if err != nil {
+							return
+						}
+						defer raw.Close()
+						raw.SetDeadline(time.Now().Add(5 * time.Second))
+						secured := tls.Server(raw, serverConfig)
+						var value [1]byte
+						if _, err := io.ReadFull(secured, value[:]); err == nil {
+							secured.Write(value[:])
+						}
+					}()
+					raw, err := (&net.Dialer{}).DialContext(ctx, "tcp", listener.Addr().String())
+					if err != nil {
+						t.Fatal(err)
+					}
+					defer raw.Close()
+					conn, _, err := googleStorageCredentials(authority, selected).ClientHandshake(ctx, authority, raw)
+					got = err
+					if err == nil {
+						defer conn.Close()
+						// A TLS 1.3 client observes rejected client authentication only on the next read.
+						conn.SetDeadline(time.Now().Add(5 * time.Second))
+						_, got = conn.Write([]byte{1})
+						if got == nil {
+							var value [1]byte
+							_, got = io.ReadFull(conn, value[:])
+						}
+					}
+				}
+				if (got == nil) != (variant == "declared") {
+					t.Fatalf("%s %s: %v", venue, variant, got)
+				}
+			})
+		}
+	}
+}
