---
source: crates/sutura-app/tests/golden/dialects.rs
expression: query.sql()
---
SELECT CAST(TRUNC("fct_subscription_monthly"."month", 'MM') AS DATE) AS "period", TO_BINARY_DOUBLE(SUM("fct_subscription_monthly"."mrr_cents")) / SUM(CASE WHEN "fct_subscription_monthly"."churned_in_month" THEN 1 ELSE 0 END) AS "revenue_per_churned_subscription" FROM "fct_subscription_monthly" WHERE "fct_subscription_monthly"."month" >= :1 AND "fct_subscription_monthly"."month" < :2 GROUP BY CAST(TRUNC("fct_subscription_monthly"."month", 'MM') AS DATE) ORDER BY CAST(TRUNC("fct_subscription_monthly"."month", 'MM') AS DATE) FETCH FIRST 10001 ROWS ONLY
