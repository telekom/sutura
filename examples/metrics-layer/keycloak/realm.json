{
  "realm": "metrics-layer",
  "enabled": true,
  "accessTokenLifespan": 3600,
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "name": "sutura:catalog.read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "sutura:metrics.ask",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "cube",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "cube-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "cube",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "regions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "regions",
            "full.path": "false",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "groups": [{ "name": "north" }, { "name": "south" }],
  "clients": [
    {
      "clientId": "sutura",
      "name": "Login client for the example callers (password grant)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "attributes": { "access.token.header.type.rfc9068": "true" },
      "defaultClientScopes": ["basic", "sutura:catalog.read", "sutura:metrics.ask"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "resource-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "https://sutura.example.com",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "https://sutura.example.com",
      "name": "sutura itself: exchanges a caller's token for one Cube accepts",
      "enabled": true,
      "publicClient": false,
      "secret": "${SUTURA_EXCHANGE_SECRET}",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "attributes": { "standard.token.exchange.enabled": "true" },
      "defaultClientScopes": ["basic", "cube"],
      "optionalClientScopes": []
    },
    {
      "clientId": "sutura-deployment",
      "name": "The deployment's own Cube user, for shared-service-user and the startup checks",
      "enabled": true,
      "publicClient": false,
      "secret": "${SUTURA_DEPLOYMENT_SECRET}",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "defaultClientScopes": ["basic", "cube"],
      "optionalClientScopes": []
    },
    {
      "clientId": "cube",
      "name": "The audience Cube accepts",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "defaultClientScopes": [],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "id": "7a1c3e5f-2b4d-4f6a-8c9e-1d3f5a7b9c01",
      "username": "alice",
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Example",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "groups": ["/north"],
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }]
    },
    {
      "id": "7a1c3e5f-2b4d-4f6a-8c9e-1d3f5a7b9c02",
      "username": "bob",
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Example",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "groups": ["/south"],
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }]
    },
    {
      "username": "service-account-sutura-deployment",
      "enabled": true,
      "serviceAccountClientId": "sutura-deployment",
      "groups": ["/north", "/south"]
    }
  ]
}
