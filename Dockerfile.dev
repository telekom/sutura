# syntax=docker/dockerfile:1.7
#
# Develop sutura with Nix on a machine where Nix does not run natively — Windows, most
# obviously, where the toolchain otherwise has to be installed by hand and drifts from
# what CI uses.
#
# This is the DEV container, not the release artifact. The release image is built by Nix
# itself (`nix build .#oci`) and contains one binary and no shell; this one is the
# opposite — a shell with the whole toolchain in it.
#
#   docker build -f Dockerfile.dev -t sutura-dev --target devshell .
#   docker run --rm -it -v "$PWD:/work" -w /work sutura-dev
#
# TARGETS
#   --target nix        a bare Nix box: flakes enabled, nothing project-specific. This is
#                       what `nix build .#oci` and the cross-compile outputs need, and the
#                       smallest thing to debug when Nix itself is the suspect.
#   --target devshell   the above plus devenv + direnv and a warmed store (default).
#
# Then inside: `devenv shell` (or just `gates`). The container is the Linux box the
# `.envrc` assumes.
#
# EVERY registry, proxy and base image is an ARG with a public default. A deployment that
# builds through an internal mirror overrides them at build time; nothing site-specific is
# baked in here.
#   docker build -f Dockerfile.dev \
#     --build-arg BASE_IMAGE=<mirror>/debian:trixie-slim \
#     --build-arg HTTP_PROXY_URL=<proxy> \
#     --build-arg NIX_INSTALLER_URL=<mirror-path> ...

ARG BASE_IMAGE=debian:trixie-slim

# --------------------------------------------------------------------- nix ---
# A dedicated stage so `--target nix` gives a usable Nix box with no project tooling —
# useful for `nix build .#oci` in CI, and the smallest thing to debug when Nix itself is
# the suspect.
FROM ${BASE_IMAGE} AS nix

ARG HTTP_PROXY_URL=""
ARG NO_PROXY_LIST="localhost,127.0.0.1,::1"
ARG NIX_INSTALLER_URL="https://nixos.org/nix/install"
ARG NIX_VERSION="2.24.10"

ENV http_proxy=${HTTP_PROXY_URL} \
    https_proxy=${HTTP_PROXY_URL} \
    no_proxy=${NO_PROXY_LIST} \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils git sudo \
 && rm -rf /var/lib/apt/lists/*

# Single-user install: a container has no need for the multi-user daemon, and it is one
# fewer moving part than systemd-in-docker.
RUN curl -fsSL "${NIX_INSTALLER_URL}" -o /tmp/nix-install \
 && sh /tmp/nix-install --no-daemon --no-channel-add \
 && rm -f /tmp/nix-install

ENV PATH=/root/.nix-profile/bin:/nix/var/nix/profiles/default/bin:${PATH}

# Flakes are not optional here: flake.nix is how the release image is built.
RUN mkdir -p /etc/nix \
 && printf 'experimental-features = nix-command flakes\nmax-jobs = auto\n' > /etc/nix/nix.conf \
 && nix --version

# ---------------------------------------------------------------- devshell ---
# Adds the project's own environment: devenv + direnv, then a warm cache of the repo's
# devenv.nix so the first interactive shell is not a cold build.
FROM nix AS devshell

ARG HTTP_PROXY_URL=""
ENV http_proxy=${HTTP_PROXY_URL} \
    https_proxy=${HTTP_PROXY_URL}

RUN nix profile install nixpkgs#devenv nixpkgs#direnv \
 && devenv version && direnv --version

# direnv needs a shell hook to do anything; without this the .envrc silently never loads
# and people end up using a system toolchain, which is the failure the .envrc exists to
# prevent.
RUN printf '\neval "$(direnv hook bash)"\n' >> /root/.bashrc \
 && printf '\n[ -f /work/.envrc ] && direnv allow /work >/dev/null 2>&1 || true\n' >> /root/.bashrc

WORKDIR /work

# Warm the store from the environment definition alone, so a bind-mounted source tree does
# not trigger a full build on first use. Copying only these files keeps the layer cacheable
# when application code changes.
COPY devenv.nix devenv.yaml* devenv.lock* rust-toolchain.toml ./
RUN devenv build 2>/dev/null || echo "devenv warm-up skipped (incomplete inputs at build time)"

CMD ["/bin/bash", "-l"]
