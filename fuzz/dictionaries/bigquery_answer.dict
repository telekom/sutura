schema="\x22schema\x22"
fields="\x22fields\x22"
rows="\x22rows\x22"
pageToken="\x22pageToken\x22"
errors="\x22errors\x22"
reason="\x22reason\x22"
message="\x22message\x22"
name="\x22name\x22"
type="\x22type\x22"
f="\x22f\x22"
v="\x22v\x22"
true_tok="true"
false_tok="false"
null_tok="null"
int_type="\x22INTEGER\x22"
float_type="\x22FLOAT\x22"
str_type="\x22STRING\x22"
bool_type="\x22BOOLEAN\x22"
date_type="\x22DATE\x22"
external_type="\x22NUMERIC\x22"
open="{\x22"
close="\x22}"
