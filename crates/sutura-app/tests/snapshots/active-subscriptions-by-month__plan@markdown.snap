---
source: crates/sutura-app/tests/golden/catalogs.rs
expression: plan
---
source: local
metric: active_subscriptions
table: fct_subscription_monthly
joins: []
bucket:
  label: period
  grain: month
  column:
    table: fct_subscription_monthly
    column: month
keys: []
measure:
  simple:
    term:
      aggregate:
        aggregate: count_distinct
        column:
          table: fct_subscription_monthly
          column: subscription_key
measure_label: active_subscriptions
filters:
  - origin: definition
    predicate:
      at_or_after:
        column:
          table: fct_subscription_monthly
          column: month
        param: 0
  - origin: definition
    predicate:
      before:
        column:
          table: fct_subscription_monthly
          column: month
        param: 1
  - origin: definition
    predicate:
      equals:
        column:
          table: fct_subscription_monthly
          column: status
        param: 2
params:
