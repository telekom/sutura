source: crates/sutura-app/tests/golden/qualified.rs
expression: query.sql()
---
SELECT `customers`.`region_code` AS `region`, CAST(DATE_TRUNC(`orders`.`order_date`, MONTH) AS DATE) AS `period`, sum(`orders`.`amount_cents`) AS `revenue` FROM `analytics-prod`.`sales`.`orders` LEFT JOIN `reference-data`.`crm`.`customers` ON `orders`.`customer_id` = `customers`.`id` WHERE `orders`.`order_date` >= ? AND `orders`.`order_date` < ? GROUP BY `customers`.`region_code`, CAST(DATE_TRUNC(`orders`.`order_date`, MONTH) AS DATE) ORDER BY `customers`.`region_code` NULLS LAST, CAST(DATE_TRUNC(`orders`.`order_date`, MONTH) AS DATE) NULLS LAST LIMIT 10001
