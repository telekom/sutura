+// array.RecordReader for ReadPartition, reusing runPlainQuery's channel-pump
+// construction (ipcReaderFromArrowIterator + reader + streamRecordBatches)
+// rather than new machinery. There is no known BigQuery schema for a bare
+// stream name, so ipcReaderFromArrowIterator falls back to the schema
+// carried in the Arrow IPC stream itself, exactly as it already does when a
+// job's reported schema field count does not match. A failure before the
+// reader exists cancels the stream's context, so its gRPC stream does not
+// stay open; once it exists, releasing it cancels the stream.
+func readPartitionRecordReader(ctx context.Context, client *bigquery.Client, readStream string, alloc memory.Allocator, resultRecordBufferSize int) (_ array.RecordReader, err error) {
+	ctx, cancelFn := context.WithCancel(ctx)
